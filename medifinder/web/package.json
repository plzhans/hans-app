{
  "name": "medifinder-web",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "local": "dotenv -e .env.local -- vite",
    "develop": "dotenv -e .env.develop.local -e .env.develop -- vite",
    "build": "tsc -b && pnpm build:bundles",
    "build:develop": "dotenv -e .env.develop.local -e .env.develop -- pnpm build:bundles",
    "build:production": "dotenv -e .env.production -- pnpm build:bundles",
    "//build:bundles": "브라우저 번들(dist)과 워커가 쓸 서버 번들(dist-server). 같은 .env 로 굽는다 — VITE_ 값이 양쪽에 상수로 박히므로 갈리면 안 된다.",
    "build:bundles": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server",
    "preview": "vite preview --port 5173 --strictPort",
    "preview:wrangler:dev": "pnpm build:develop && CI=true WRANGLER_SEND_METRICS=false pnpm --allow-build=esbuild,workerd dlx wrangler@4 dev --assets dist",
    "spec:local": "pnpm -C ../../backend run openapi:gen:local",
    "spec:dev": "pnpm -C ../../backend run openapi:gen:dev",
    "api:sync": "pnpm spec:local && pnpm -C ../../clients/hans-api-sdk api:gen"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@hans-api/sdk": "link:../../clients/hans-api-sdk",
    "@hansapp/auth-sdk": "link:../../frontend/auth-sdk",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-query": "^5.62.0",
    "capacitor-native-settings": "^8.1.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
