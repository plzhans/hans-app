# MediFinder 운영 CLI. 이 파일을 `.env.develop` · `.env.production` 으로 복사해 쓴다.
#
# **환경 이름은 여기 없다.** 어느 파일을 읽을지는 `--env` 가 정한다 — 그 값이 파일 안에도
# 있으면 둘이 어긋났을 때 무엇이 맞는지 알 수 없다.
#
# **자격증명은 소유한 시스템 이름을 단다.** hans-api 것은 HANSAPP_, Cloudflare 것은
# CLOUDFLARE_, medifinder 자신의 것만 MEDIFINDER_ 다 — 프론트(.env.develop)의
# VITE_HANSAPP_BASE_URL 과 같은 규칙이다.

# hans-api 주소. **키를 발급한 환경과 맞아야 한다** — 어긋나면 401 이다.
#   develop    https://develop-api.plzhans.com
#   production https://api.plzhans.com
HANSAPP_BASE_URL=

# 서버-서버 자격증명. sk_{appId}_{keyId}_{rand}
# X-Client-Id 를 쓰지 않는 이유는 그쪽이 요청 Origin 을 대조하기 때문이다 — CLI 는 Origin 이 없다.
HANSAPP_SERVER_KEY=

# 사이트맵에 적을 주소.
#   develop    https://develop.medifinder.kr
#   production https://medifinder.kr
MEDIFINDER_SITE_URL=


# `sitemap deploy` 에만 쓴다. wrangler 가 환경변수에서 직접 가져가므로 CLI 는 값을 읽지 않는다.
CLOUDFLARE_API_TOKEN=
