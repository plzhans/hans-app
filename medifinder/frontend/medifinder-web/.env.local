# ⚠️ 이 파일은 **로컬 전용이 아니다.**
#
# vite 는 .env.local 을 **모든 mode 에서** 읽는다(공식 스펙). 이 레포는 파일 이름이 겹치는
# 바람에 이것을 `local` 환경의 설정으로 쓰고 있을 뿐이라, 여기 적은 키는 develop·production
# 빌드에도 그대로 딸려 간다.
#
# **backend 의 local 과 의미가 정반대다.** 백엔드는 config/config.<환경>.yaml 중 **그 환경
# 것 하나만** 골라 읽으므로 config.local.yaml 은 진짜 로컬 전용이고, 운영에는 존재조차
# 하지 않는다. 여기서는 `.local` 이 "나만 쓰는 값" 이 아니라 "**모두에게 딸려가는 값**" 이다.
# (백엔드에서 그 뜻에 해당하는 것은 config/.env.<환경>.local 쪽 개인 오버라이드다.)
#
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local
#             ↑ 항상 읽힘   ↑ 같은 키가 여기 있어야 이긴다
#
# **여기에 키를 추가하면 .env.develop·.env.production 에도 반드시 적을 것.** 값이 달라도 되고
# 비워도 되지만, 없으면 이 파일의 로컬 값이 배포 번들에 박힌다. 빌드는 성공하고 배포도
# 초록불이라 사용자가 눌러봐야 드러난다 — 실제로 .env.production 에 VITE_AUTH_WEB_URL 이
# 없어서 이 파일의 `/auth` 가 이겼고, 운영 로그인이 plzhans.com/auth/login 으로 갔다.
# (ci-build.sh 가 이 규칙을 검사해 어기면 빌드를 세운다.)

# frontend: local

VITE_HANSAPP_BASE_URL=http://127.0.0.1:3000
# 네이버 지도(ncloud) client id. 상세 페이지 지도에 사용.
VITE_NCLOUD_CLIENT_ID=27qtiocnhz
# 카카온 연동 KEY
VITE_KAKAO_JS_KEY=9eb0f0ec1592537de4401457047ca2c7
# 연동 정보(hpid/ykiho) 노출 여부. 비밀 정보라 production 에서는 false.
VITE_SHOW_INTEGRATION_INFO=true

# canonical·hreflang 에 쓰는 절대 URL. 상대경로면 검색엔진이 언어 묶음을 못 만든다.
VITE_SITE_URL=http://127.0.0.1:5173

# 문의/노출용 대표 이메일 (footer 등). 빌드 시 번들에 인라인된다.
VITE_CONTACT_EMAIL=medifinder.help@gmail.com

# 지도 플랫폼 키 (선택). 비우면 해당 탭에 "키 미설정" 안내가 뜬다.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAvWaly6gIFHVD7xt1ecvzyRGMZlv2MGnE

# hansapp 앱 콘솔에서 발급한 WEB 클라이언트 ID. 요청 시 X-Client-Id 헤더로 나간다.
# 공개 식별자라 번들에 노출돼도 된다 — 서버가 요청 Origin 을 등록 오리진과 대조해 막는다.
# 등록 오리진에 http://127.0.0.1:5173 이 있어야 통과한다.
VITE_HANSAPP_CLIENT_ID=cl_fixed_medifinder

# 인증웹 base URL. 마이페이지 링크(/me)에 쓴다.
# 로그인 이동 주소는 discovery 의 authorization_endpoint 가 정한다(백엔드 auth.externalUrl).
# 로컬 인증웹은 5273 포트이고 라우터 프리픽스가 /auth 다(VITE_ROUTER_BASE).
VITE_AUTH_WEB_URL=http://127.0.0.1:5273/auth

# 실행 환경 이름. Sentry 의 environment 태그가 이 값이다(백엔드 APP_ENV 와 이름을 맞춘다).
# vite 의 mode 로는 못 가른다 — build 는 develop/production 둘 다 mode=production 이다.
VITE_APP_ENV=local
# 에러 추적(Sentry). **로컬은 끈다** — 내 머신 에러가 팀 이슈 스트림에 섞이면 안 된다.
# 연동을 직접 확인할 때만 아래 줄의 주석을 푼다(DSN 은 비밀 아님 — 전송 전용 공개값).
VITE_SENTRY_DSN=
#VITE_SENTRY_DSN=https://3dec394c8ed126529cbbfe2fe69fea40@o4507886343159808.ingest.de.sentry.io/4511828913422416
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
