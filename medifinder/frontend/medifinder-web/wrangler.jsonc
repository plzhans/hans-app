// Cloudflare Workers 설정. 배포할 때 wrangler 가 읽는다(이 파일이 업로드되지는 않는다).
// ci-deploy.sh 가 이 디렉터리로 cd 하므로 자동으로 잡힌다.
//
// [여기 없는 것]
// 이름(--name)·자산 경로(--assets)·런타임 변수(--var)는 배포 스크립트가 CLI 로 넘긴다.
// 환경마다 달라지는 값이라 파일에 박으면 환경별로 갈린다 — frontend/ci-deploy.sh 참고.
{
  // 런타임 동작 기준일. 이 날짜의 동작으로 고정된다 — Cloudflare 가 런타임을 고쳐도
  // 이 워커는 그대로 돈다. 올리는 것이 새 동작을 받아들이는 행위다.
  //
  // 올리는 순서: 날짜를 고치고 → `pnpm preview:wrangler:dev` 로 확인하고 → 배포.
  // 프론트 프로젝트마다 각자 정한다. 나머지 셋은 아직 2026-07-01 이다.
  "compatibility_date": "2026-09-08",

  // 로컬 개발 서버(`pnpm preview:wrangler:dev`). vite preview 가 5173 이라 겹치지 않게 둔다.
  "dev": {
    "port": 6173
  },

  // 워커 진입점. 하는 일은 응답 HTML 의 <head> 를 채우는 것뿐이다.
  "main": "./cloudflare/workers/main.ts",

  "assets": {
    // 라우트에 없는 경로는 404 다. Cloudflare 가 dist/404.html 을 404 상태로 내보낸다
    // (그 파일은 index.html 사본이라 SPA 가 그대로 떠서 NotFound 화면을 그린다).
    //
    // single-page-application 으로 두면 안 된다. 모든 미매칭 경로에 index.html 을 200 으로
    // 돌려줘서, 오타 난 주소까지 색인 대상이 된다. 실제 SPA 경로는 아래 run_worker_first 에
    // 전부 적혀 있고 워커가 /index.html 을 직접 집어다 쓴다.
    "not_found_handling": "404-page",

    // 워커가 env.ASSETS.fetch() 로 껍데기를 꺼낼 때 쓴다.
    "binding": "ASSETS",

    // 이 앱이 가진 경로를 전부 적는다. 여기 없으면 워커가 돌지 않고 404 문서가 나간다.
    //
    // not_found_handling 이 404-page 라 목록에서 빠진 SPA 경로는 그대로 404 가 된다.
    // 라우트를 추가하면 cloudflare/workers/routing.ts 의 matchRoute 와 여기를 같이 고칠 것.
    //
    // true 로 두면 안 된다. 정적 자산 요청은 무료·무제한인데 워커를 거치면 과금 대상이
    // 되고, 무료 플랜의 일 10만 요청 상한에도 함께 잡힌다.
    "run_worker_first": [
      "/",
      "/search", "/search/",
      "/me", "/me/",
      "/auth/callback",
      "/hospitals/*",
      "/terms", "/terms/*",
      "/privacy", "/privacy/",
      "/ko", "/ko/*",
      "/en-us", "/en-us/*",
      "/ja", "/ja/*",
      "/zh-hans", "/zh-hans/*"
    ]
  }
}
