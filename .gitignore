# dependencies
**/node_modules/

# 이 레포는 pnpm 전용(packageManager: pnpm). npm 이 실수로 만든 package-lock.json 은
# pnpm-lock.yaml 과 어긋나 VSCode 경고를 낸다. 이름으로 막아 어느 서브트리든 잡는다.
**/package-lock.json

# build output
**/dist/
**/build/
**/coverage/

# env 는 서브트리별로 각자 관리한다. backend 와 frontend 의 정책이 정반대라
# 루트에서 한 번에 막으면 한쪽이 반드시 어긋난다.
#   backend/.gitignore  — 전부 무시(시크릿). .example·.enc 만 추적.
#   frontend/.gitignore — 전부 추적(값이 전부 VITE_* 공개 상수). .env.local(개인용)만 무시.

# logs
**/*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
*.swp

# misc
**/.turbo/

# 로컬 배포 테스트용 값. 시크릿이 들어간다. .example 만 커밋한다.
# 배포 시크릿(SSH 키·WireGuard conf). local-deploy.sh 가 워킹디렉터리(backend) 루트에서 읽는다.
#   backend/local-deploy-develop.env · backend/local-deploy-production.env …
#
# **경로가 아니라 이름으로 막는다.** 예전엔 `scripts/ci/deploy-backend.local.sh.env` 라고
# 경로를 박아뒀는데, 파일을 옮기는 순간 규칙이 헛돌아 시크릿이 추적 대상이 됐다.
# 파일이 어디로 가든 따라가게 이름으로 건다.
#
# `local-deploy-*.env` 가 지금 이름, `.deploy*.env` 는 옛 이름(config/<환경>/.deploy.env)을 잡는다.
# local-deploy.env.example 은 안 걸린다('-<환경>' 이 아니라 '.env.example' 로 끝난다). 커밋 대상 템플릿이다.
local-deploy-*.env
.deploy*.env

# 배포 번들. build-backend.sh 가 앱마다 자립형 디렉터리(dist + node_modules)를 만든다.
# **앱 하나가 350MB 를 넘는다.** 절대 커밋하지 않는다.
backend/.deploy/

# db-sync.sh 백업 (실데이터)
backend/backups/

# 배포 단계들이 주고받는 작업 공간. **복호화된 시크릿과 SSH 키가 들어간다.**
# stage/secret-cleanup.sh 가 지우지만, 개별 단계만 돌렸다면 남아 있을 수 있다.
.deploy-work/
