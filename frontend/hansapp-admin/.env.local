# ⚠️ 이 파일은 **로컬 전용이 아니다.**
#
# vite 는 .env.local 을 모든 mode 에서 읽는다. 여기 적은 키는 develop·production 빌드에도
# 딸려 간다. **키를 추가하면 .env.develop·.env.production 에도 반드시 적을 것** —
# 없으면 이 파일의 로컬 값이 배포 번들에 그대로 박힌다.

VITE_APP_ENV=local

# 관리자 API 주소. 배포에서는 같은 오리진이라 빈 값(상대 경로)이지만,
# 로컬은 프론트 5275 / API 3001 로 포트가 갈려 절대 주소가 필요하다.
VITE_ADMIN_API_BASE_URL=http://127.0.0.1:3001

# 로그인 힌트 쿠키 이름. **백엔드가 심는 이름과 정확히 같아야 한다.**
# 백엔드 규칙: production 만 접두사 없음, 나머지는 `<환경>.` (admin-cookie.ts 참고).
# 어긋나면 "로그인은 됐는데 화면은 로그아웃" 이 된다.
VITE_SESSION_HINT_COOKIE_NAME=local.hansapp.admin_session

# 에러 추적. 전송 전용 공개 엔드포인트라 비밀이 아니다(번들에 박힌다).
# **비우면 Sentry 를 아예 켜지 않는다.**
VITE_SENTRY_DSN=
# 성능 트레이스 표본 비율. 0=끔, 1=전부.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
