# ⚠️ 이 파일은 **로컬 전용이 아니다.**
#
# vite 는 .env.local 을 모든 mode 에서 읽는다. 여기 적은 키는 develop·production 빌드에도
# 딸려 간다. **키를 추가하면 .env.develop·.env.production 에도 반드시 적을 것** —
# 없으면 이 파일의 로컬 값이 배포 번들에 그대로 박힌다.

VITE_APP_ENV=production

# 관리자 API 주소. **배포에서는 비운다** — 화면과 API 가 같은 이미지·같은 오리진이라
# 상대 경로면 된다. 절대 주소를 박으면 다른 이름으로 접근했을 때(서버 IP·임시 별칭)
# 화면은 뜨는데 API 만 그 도메인으로 날아가 쿠키가 안 실린다.
# 로컬만 절대 주소가 필요하다(프론트 5275 / API 3001 로 포트가 갈린다).
VITE_ADMIN_API_BASE_URL=

# 로그인 힌트 쿠키 이름. **백엔드가 심는 이름과 정확히 같아야 한다.**
# 백엔드 규칙: production 만 접두사 없음, 나머지는 `<환경>.` (admin-cookie.ts 참고).
# 어긋나면 "로그인은 됐는데 화면은 로그아웃" 이 된다.
VITE_SESSION_HINT_COOKIE_NAME=hansapp.admin_session
