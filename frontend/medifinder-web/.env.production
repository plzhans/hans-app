# frontend: production

# API base. medifinder 전용 백엔드가 아직 없어서 지금은 hansapi 를 쓴다.
#   hansapi  develop: develop-api.plzhans.com   production: api.plzhans.com
# medifinder 자체 API 가 생기면 {환경}-api.medifinder.kr 형태로 바꾼다.
VITE_HANSAPI_BASE_URL=https://api.plzhans.com

# hansapi WEB 클라이언트 ID → X-Client-Id 헤더로 나간다. 공개값이며 서버가 Origin 을 대조한다.
#
# 고정 ID(cl_fixed_*)라 환경마다 값이 같다 — DB 를 다시 만들어도 이 파일은 그대로 둔다.
# 다만 **행 자체는 환경별로 만들어야 한다.** production DB 에 아직 없으면 401 이 난다:
#   hansapi-cli app client --env production --app <id> --name medifinder-web \
#     --client-id medifinder-web --origin https://medifinder.kr
VITE_HANSAPI_CLIENT_ID=cl_fixed_medifinder-web

# 네이버 지도(ncloud) client id
VITE_NCLOUD_CLIENT_ID=27qtiocnhz
# 카카온 연동 KEY
VITE_KAKAO_JS_KEY=f7cdb42c0a71afaf0250af1c4e03a0f8
# 연동 정보(hpid/ykiho)는 비밀 정보 — production 에서는 노출하지 않는다.
VITE_SHOW_INTEGRATION_INFO=false

# canonical·hreflang 에 쓰는 절대 URL
VITE_SITE_URL=https://medifinder.kr

# 문의/노출용 대표 이메일 (footer 등). 빌드 시 번들에 인라인된다.
VITE_CONTACT_EMAIL=medifinder.help@gmail.com

# 구글 지도 플랫폼 키
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDbPZjhRg2bZBSXFMMAYUPekxbuUKtH86Q