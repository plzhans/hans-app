# frontend: develop

# API base. medifinder 전용 백엔드가 아직 없어서 지금은 hansapi(develop) 를 쓴다.
# 자체 API 가 생기면 develop-api.medifinder.kr 로 교체.
VITE_HANSAPI_BASE_URL=https://develop-api.plzhans.com

# hansapi WEB 클라이언트 ID → X-Client-Id 헤더로 나간다. 공개값이며 서버가 Origin 을 대조한다.
# local 과 같은 값인 이유: 로컬 백엔드도 develop DB 를 바라본다.
# 등록 오리진에 https://develop.medifinder.kr 이 있어야 통과한다.
VITE_HANSAPI_CLIENT_ID=cl_fixed_medifinder

# 네이버 지도(ncloud) client id
VITE_NCLOUD_CLIENT_ID=27qtiocnhz
# 카카온 연동 KEY
VITE_KAKAO_JS_KEY=f7cdb42c0a71afaf0250af1c4e03a0f8

# 연동 정보(hpid/ykiho) 노출 여부. 비밀 정보라 production 에서는 false.
VITE_SHOW_INTEGRATION_INFO=true

# canonical·hreflang 에 쓰는 절대 URL
VITE_SITE_URL=https://develop.medifinder.kr

# 문의/노출용 대표 이메일 (footer 등). 빌드 시 번들에 인라인된다.
VITE_CONTACT_EMAIL=medifinder.help@gmail.com

# 지도 플랫폼 키 (선택). 비우면 해당 탭에 "키 미설정" 안내가 뜬다.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDbPZjhRg2bZBSXFMMAYUPekxbuUKtH86Q

# 로그인 UI(hansapp-web)의 base URL. SDK 가 여기로 전체 페이지 이동시킨다.
# **아직 안 채웠다** — 배포된 포털 도메인을 확인해서 넣어야 로그인이 동작한다.
VITE_AUTH_WEB_URL=

# 실행 환경 이름. Sentry 의 environment 태그가 이 값이다(백엔드 APP_ENV 와 이름을 맞춘다).
# vite 의 mode 로는 못 가른다 — build 는 develop/production 둘 다 mode=production 이다.
VITE_APP_ENV=develop
# 에러 추적(Sentry). **DSN 은 비밀이 아니다** — 전송 전용 공개 엔드포인트라 어차피 번들에 구워진다.
# 비우면 Sentry 를 켜지 않는다.
VITE_SENTRY_DSN=https://5147c8b0a2c9bbb3c0d5a43dd97e5022@o4507886343159808.ingest.de.sentry.io/4511811444932688
# 성능 트레이스 표본 비율(0=끔, 1=전부). dev 는 트래픽이 적어 전부 본다.
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
