// Cloudflare Workers 정적 자산 설정. **배포할 때 wrangler 가 읽어 Worker 설정으로 등록한다**
// (이 파일이 업로드되는 것은 아니다). 실행 위치가 이 디렉터리라 자동으로 잡힌다.
//
// [왜 필요한가]
// 이 앱은 SPA 다. /login 같은 경로는 실제 파일이 아니라 react-router 가 브라우저에서
// 그린다. 그런데 정적 자산 Worker 는 파일이 없으면 404 를 내므로, 주소를 직접 치거나
// 리다이렉트로 들어오면 화면을 보기도 전에 막힌다 — 로그인 리다이렉트가 그렇게 깨졌다.
//
// single-page-application 은 못 찾은 경로에 index.html 을 **200 으로** 돌려준다.
// 404 로 주면 브라우저는 받지만 검색엔진·모니터링이 오류로 집계한다.
//
// [왜 CLI 플래그가 아닌가]
// wrangler 의 assets 는 객체(directory·not_found_handling·html_handling)라 평평한
// 플래그로 표현할 수단이 없다. --assets 는 디렉터리 하나만 받는다.
//
// [여기 없는 것]
// 이름(--name)과 compatibility-date 는 배포 스크립트가 CLI 로 넘긴다. 환경마다 달라지는
// 값이라 파일에 박으면 환경별로 파일이 갈린다 — frontend/ci-deploy.sh 참고.
{
  // 런타임 동작 기준일. **이 날짜의 동작으로 고정한다.**
  //
  // Cloudflare 가 런타임을 고쳐도 우리 워커는 이 날짜의 동작 그대로 돈다.
  // 날짜를 올리는 것이 새 동작을 받아들이는 행위다 — 그래서 배포마다 "오늘"을 쓰면
  // 같은 커밋을 다시 배포하는 것만으로 결과가 달라져 롤백이 롤백이 아니게 된다.
  //
  // 2026-09-08 로 올렸다: 이 날짜의 런타임에서 로컬 검증(wrangler dev)을 마쳤다.
  // **다음에 올릴 때도 같은 순서다** — 올리고, 로컬에서 확인하고, 그 다음 배포.
  //
  // ci-deploy.sh 의 CF_COMPAT_DATE(2026-07-01)는 이 값을 덮지 않는다. 프로젝트가 스스로
  // 선언하면 그쪽이 이긴다 — 나머지 프론트 넷은 아직 그 기준일에 머물러 있고,
  // 검증 없이 같이 끌려 올라가면 안 되기 때문이다.
  "compatibility_date": "2026-09-08",

  // 로컬 개발 서버(`pnpm preview:wrangler:dev`).
  //
  // vite preview 가 5173 을 쓰므로 겹치지 않게 6173 이다.
  // **포트는 환경 따라 변하는 값이 아니라서 여기 둔다** — 스크립트에 --port 로 박으면
  // 바꿀 때마다 명령줄을 고쳐야 한다.
  "dev": {
    "port": 6173
  },

  // 워커 진입점. **여기 생기면 배포에도 함께 올라간다** — assets 전용 Worker 가 아니게 된다.
  // 하는 일은 응답 HTML 의 <head> 를 채우는 것뿐이다(cloudflare/workers/main.ts 참고).
  "main": "./cloudflare/workers/main.ts",

  "assets": {
    "not_found_handling": "single-page-application",

    // 워커가 env.ASSETS.fetch() 로 껍데기를 꺼내 쓸 손잡이.
    "binding": "ASSETS",

    // **HTML 경로만 워커를 태운다.**
    //
    // 기본값은 "에셋이 있으면 그걸 먼저" 라서, / 처럼 index.html 이 실제로 존재하는
    // 경로는 워커가 아예 안 돈다. 그래서 태울 경로를 명시한다.
    //
    // true 로 두면 안 된다. 정적 자산 요청은 **무료·무제한**인데 워커를 거치는 순간
    // 과금 대상이 되고, 무료 플랜에서는 일 10만 요청 상한에 함께 잡힌다.
    // /assets/* 까지 태우면 그 자릿수가 달라진다.
    //
    // directory 는 여기 적지 않는다 — ci-deploy.sh 가 --assets 로 넘기고 CLI 가 이긴다.
    // 그래서 `wrangler dev` 도 --assets 를 줘야 한다(package.json 의 preview:worker).
    "run_worker_first": [
      "/",
      "/search",
      "/hospitals/*",
      "/terms/*",
      "/en-us", "/en-us/*",
      "/ja", "/ja/*",
      "/zh-hans", "/zh-hans/*"
    ]
  }
}
