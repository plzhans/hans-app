# hansapp-web(콘솔): local — 단일 오리진 front door(127.0.0.1:5274). API 도 127.0.0.1 로 맞춘다
# (쿠키는 호스트 기준 → 프론트·API·포털 전부 127.0.0.1 이어야 refresh 쿠키가 공유된다. localhost 금지).
VITE_HANSAPP_BASE_URL=http://127.0.0.1:3000
# 로그인 포털은 같은 오리진의 /auth 로 프록시된다(vite proxy). 상대경로.
VITE_AUTH_WEB_URL=/auth
# Google Analytics 측정 ID. 로컬은 미설정(추적 안 함).
VITE_GOOGLE_ANALYTICS_ID=
# 실행 환경 이름(Sentry environment 태그).
VITE_APP_ENV=local
# 에러 추적(Sentry). **로컬은 끈다** — 내 머신 에러가 팀 이슈 스트림에 섞이면 안 된다.
# 연동을 직접 확인하고 싶을 때만 아래 줄의 주석을 푼다(DSN 은 비밀 아님 — 전송 전용 공개값).
VITE_SENTRY_DSN=
#VITE_SENTRY_DSN=https://8109761cd7f3557dc29ff2983298eef0@o4507886343159808.ingest.de.sentry.io/4511811436806224
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
