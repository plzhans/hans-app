# hansapp-auth: develop
# 인증 백엔드(api) base. 이 프론트는 로그인/가입/토큰 갱신을 여기로 호출한다.
VITE_HANSAPP_BASE_URL=https://api.plzhans.com
# 인증웹. **빈 값이라도 반드시 적는다** — 안 적으면 .env.local 의 /auth 가 새어
# 들어온다(vite 는 .env.local 을 모든 mode 에서 읽는다).
VITE_AUTH_WEB_URL=https://auth.plzhans.com
# 서비스 루트 도메인. 백엔드 APP_ROOT_DOMAIN·인증웹과 **같은 값**이어야 한다.
# 로그인 힌트 쿠키를 지울 때 심을 때와 같은 domain 을 써야 브라우저가 지운다.
VITE_APP_ROOT_DOMAIN=plzhans.com
# 로그인 힌트 쿠키 이름. 백엔드 auth.cookiePrefix + hansapp.session 과 **같아야** 한다.
# 환경마다 다른 이유: develop 과 운영이 쿠키 도메인(plzhans.com)을 공유해서, 이름까지
# 같으면 서로의 세션을 덮어쓰고 상대 DB 에 없는 토큰이라 거절돼 양쪽이 로그아웃된다.
VITE_SESSION_HINT_COOKIE_NAME=hansapp.session
# Google Analytics 측정 ID. 값이 있을 때만 gtag.js 를 로드한다(비우면 추적 안 함).
VITE_GOOGLE_ANALYTICS_ID=G-TJ9WFW84F4
# 실행 환경 이름. Sentry 의 environment 태그가 이 값이다(백엔드 APP_ENV 와 이름을 맞춘다).
VITE_APP_ENV=production
# 에러 추적(Sentry). DSN 은 비밀이 아니다(전송 전용 공개값 — 번들에 그대로 구워진다). 비우면 끈다.
VITE_SENTRY_DSN=https://8109761cd7f3557dc29ff2983298eef0@o4507886343159808.ingest.de.sentry.io/4511811436806224
# 성능 트레이스 표본 비율. 운영은 방문자가 많아 10% 만 샘플링한다(쿼터·전송량).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# 상단·본문의 바로가기 링크. **환경마다 주소가 다르므로 전부 적는다** — 안 적으면
# 코드의 기본값(운영 주소)으로 떨어져서 develop 포털이 운영 문서·사이트로 보낸다.
# 규칙으로 유도할 수 없다(docs 는 develop- 접두, medifinder 는 develop. 접두에 도메인도 다름).
VITE_LINK_MEDIFINDER=https://medifinder.kr
VITE_LINK_DOCS=https://docs.plzhans.com

# 노출용 대표 이메일(푸터 등). 빌드 시 번들에 인라인된다.
# **약관·방침의 연락처는 이 값이 아니라 문서(@hansapp/legal)에 박혀 있다** — 문서에 적힌
# 연락처를 바꾸는 것은 개정이라 공지 대상이고, 환경마다 달라져서도 안 된다. 여기 값은
# 화면 장식용이므로 둘이 어긋나지 않게 같이 고칠 것.
VITE_CONTACT_EMAIL=plzhans@gmail.com

# AI/LLM 업체 키(BYOK) 등록 기능. **`true` 만 켠 것으로 본다** — 빈 값·미설정·`false` 는 전부 꺼짐.
# 아직 열지 않은 기능의 화면을 잠그는 스위치다. 켜면 앱 상세의 AI/LLM 탭에서 등록·수정·삭제가
# 열리고, 꺼 두면 버튼을 누를 때 "사용이 제한되어 있습니다" 안내만 뜬다.
# **서버는 이 값을 모른다** — 백엔드 API 는 언제나 열려 있고 잠그는 것은 화면뿐이다.
VITE_FEATURE_LLM_PROVIDER_KEYS=
