// 사이트맵 전용 Worker 의 설정. **본체(../../wrangler.jsonc)와 따로 둔다** — 같은 디렉터리에서
// wrangler 를 부르면 본체 설정이 딸려 들어가는데, 이 워커는 성격이 반대다.
//
// 이름(--name)과 자산 경로(--assets)는 배포하는 쪽이 넘긴다. 환경마다 달라지는 값이라
// 파일에 박으면 환경별로 파일이 갈린다(본체 wrangler.jsonc 와 같은 이유).
{
  // 본체와 같은 날짜로 둔다. 한 사이트를 이루는 두 워커가 서로 다른 기준일을 갖고 있으면
  // 나중에 코드가 생겼을 때 어느 쪽이 무슨 동작인지 헷갈린다.
  "compatibility_date": "2026-07-01",

  "assets": {
    // **없는 파일은 404 다.** 본체는 SPA 라 못 찾으면 index.html 을 200 으로 주는데,
    // 사이트맵 워커가 그러면 검색엔진이 "사이트맵이 HTML" 오류로 받는다.
    "not_found_handling": "none"
  }
}
