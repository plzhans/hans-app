# frontend/deploy.sh 가 읽는 값. 복사해서 frontend/.env 로 둔다.
#
#   cp frontend/.env.example frontend/.env
#   frontend/deploy.sh develop medifinder-web
#
# **이건 vite 가 읽는 env 가 아니다.** 각 프로젝트가 자기 루트라서 vite 는
# frontend/<프로젝트>/.env.* 만 본다. 이 파일은 배포 스크립트 전용이고,
# 그래서 여기 값만 커밋하지 않는다(frontend/.gitignore 참고).
#
# 이름은 wrangler 가 직접 읽는 이름 그대로다. 우리가 다시 넘기지 않는다.
# CI 에서는 같은 값이 GitHub Secrets 로 들어간다(.github/workflows/fe-deploy.yml).

# Cloudflare 대시보드 → 우상단 계정 메뉴 → Account ID
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare 대시보드 → My Profile → API Tokens → Create Token
# 권한: Account · Workers Scripts · Edit
CLOUDFLARE_API_TOKEN=

# 선택. 비우면 ci-deploy.sh 가 <환경 약칭>-<프로젝트> 규칙으로 유도한다.
#   dev-medifinder-web · prod-medifinder-web
# 규칙에서 벗어나는 이름을 쓸 때만 채운다.
#CF_WORKER_NAME=
