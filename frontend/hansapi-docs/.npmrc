# vitepress-plugin-mermaid 는 mermaid 의 전이 의존(dayjs·cytoscape 등)을 optimizeDeps.include 에
# **베어 이름**으로 넣는다. pnpm 은 전이 의존을 프로젝트 root node_modules 로 끌어올리지 않아
# Vite 가 이들을 resolve 하지 못하고("Failed to resolve dependency"), 결과적으로 dev 에서
# dayjs UMD 가 그대로 서빙돼 "does not provide an export named 'default'" 로 터진다.
# 아래 패턴으로 mermaid 가 이미 쓰는 그 버전을 root 로 hoist 해 resolve 가능하게 만든다(중복 설치 없음).
public-hoist-pattern[]=dayjs
public-hoist-pattern[]=cytoscape
public-hoist-pattern[]=cytoscape-cose-bilkent
public-hoist-pattern[]=@braintree/sanitize-url
public-hoist-pattern[]=debug
