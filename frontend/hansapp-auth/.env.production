# hansapp-auth(인증웹): production
# 배포는 자기 서브도메인이라 루트에 마운트한다. **빈 값이라도 반드시 적는다** —
# 안 적으면 .env.local 의 /auth 가 새어 들어온다(vite 는 .env.local 을 모든 mode 에서 읽는다).
VITE_BASE=/
VITE_ROUTER_BASE=/
VITE_HANSAPP_BASE_URL=https://api.plzhans.com
# 서비스 루트 도메인. 백엔드 APP_ROOT_DOMAIN 과 같은 값. 로그인 후 복귀(return)를 이 도메인
# 계열(자신·서브도메인)로만 허용한다 = 백엔드 isFirstPartyOrigin 과 동일한 1st-party 정의.
VITE_APP_ROOT_DOMAIN=plzhans.com
# 실행 환경 이름. Sentry 의 environment 태그가 이 값이다(백엔드 APP_ENV 와 이름을 맞춘다).
VITE_APP_ENV=production
# Google Analytics 측정 ID. 값이 있을 때만 gtag.js 를 로드한다(비우면 추적 안 함).
VITE_GOOGLE_ANALYTICS_ID=G-2MEG0SFKBG
# 에러 추적(Sentry). DSN 은 비밀이 아니다(전송 전용 공개값). 비우면 끈다.
VITE_SENTRY_DSN=https://93a3fc5d9b5e1720e0e9f39273e202b1@o4507886343159808.ingest.de.sentry.io/4511828907917392
# 성능 트레이스 표본 비율. 운영은 방문자가 많아 10% 만 샘플링한다.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
