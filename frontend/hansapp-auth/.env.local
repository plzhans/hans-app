# ⚠️ 이 파일은 **로컬 전용이 아니다.**
#
# vite 는 .env.local 을 **모든 mode 에서** 읽는다(공식 스펙). 이 레포는 파일 이름이 겹치는
# 바람에 이것을 `local` 환경의 설정으로 쓰고 있을 뿐이라, 여기 적은 키는 develop·production
# 빌드에도 그대로 딸려 간다.
#
# **backend 의 local 과 의미가 정반대다.** 백엔드는 config/config.<환경>.yaml 중 **그 환경
# 것 하나만** 골라 읽으므로 config.local.yaml 은 진짜 로컬 전용이고, 운영에는 존재조차
# 하지 않는다. 여기서는 `.local` 이 "나만 쓰는 값" 이 아니라 "**모두에게 딸려가는 값**" 이다.
# (백엔드에서 그 뜻에 해당하는 것은 config/.env.<환경>.local 쪽 개인 오버라이드다.)
#
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local
#             ↑ 항상 읽힘   ↑ 같은 키가 여기 있어야 이긴다
#
# **여기에 키를 추가하면 .env.develop·.env.production 에도 반드시 적을 것.** 값이 달라도 되고
# 비워도 되지만, 없으면 이 파일의 로컬 값이 배포 번들에 박힌다. 빌드는 성공하고 배포도
# 초록불이라 사용자가 눌러봐야 드러난다 — 실제로 .env.production 에 VITE_AUTH_WEB_URL 이
# 없어서 이 파일의 `/auth` 가 이겼고, 운영 로그인이 plzhans.com/auth/login 으로 갔다.
# (ci-build.sh 가 이 규칙을 검사해 어기면 빌드를 세운다.)

# hansapp-auth(인증웹): local — 콘솔 5274 가 /auth 로 프록시. base·router 를 /auth 로 마운트.
VITE_HANSAPP_BASE_URL=http://127.0.0.1:3000
# 포털웹(hansapp-web) 홈. 인증웹에서 "홈으로" 로 돌아갈 곳이다.
# 루트 도메인에서 유도할 수 없다 — 환경마다 접두사가 다르다(develop.* / 무접두).
VITE_PORTAL_WEB_URL=/
VITE_BASE=/auth/
VITE_ROUTER_BASE=/auth
# 서비스 루트 도메인. 로컬은 비운다 → 백엔드와 동일하게 루프백(127.0.0.1/localhost)만 복귀 허용.
VITE_APP_ROOT_DOMAIN=
# 로그인 힌트 쿠키 이름. 백엔드 auth.cookiePrefix + hansapp.session 과 **같아야** 한다.
# 환경마다 다른 이유: develop 과 운영이 쿠키 도메인(plzhans.com)을 공유해서, 이름까지
# 같으면 서로의 세션을 덮어쓰고 상대 DB 에 없는 토큰이라 거절돼 양쪽이 로그아웃된다.
VITE_SESSION_HINT_COOKIE_NAME=local.hansapp.session
# 실행 환경 이름(Sentry environment 태그).
VITE_APP_ENV=local
# 에러 추적(Sentry). **로컬은 끈다** — 내 머신 에러가 팀 이슈 스트림에 섞이면 안 된다.
# 연동을 직접 확인할 때만 아래 줄의 주석을 푼다(DSN 은 비밀 아님 — 전송 전용 공개값).
VITE_SENTRY_DSN=
#VITE_SENTRY_DSN=https://93a3fc5d9b5e1720e0e9f39273e202b1@o4507886343159808.ingest.de.sentry.io/4511828907917392
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
# Google AdSense. **비우면 로그인 화면의 광고 단을 아예 그리지 않는다**(카드도 원래 폭).
# 게시자 ID 는 계정 하나에 하나, 단위 ID 는 광고 자리마다 새로 만들어 받는다. 둘 다 비밀이
# 아니다 — 광고 태그에 그대로 실려 나간다.
VITE_GOOGLE_ADSENSE_CLIENT_ID=
VITE_GOOGLE_ADSENSE_SLOT_LOGIN=
# 푸터에 노출하는 대표 이메일. 포털(hansapp-web)과 같은 값을 쓴다.
VITE_CONTACT_EMAIL=plzhans@gmail.com
