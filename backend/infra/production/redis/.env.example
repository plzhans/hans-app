# production Redis. 이 파일을 서버의 compose 디렉터리에 .env 로 두면 compose 가 읽는다.
#
#   cp .env.example .env

# 접속 비밀번호. 없으면 compose 가 뜨지 않는다.
REDIS_PASSWORD=

# 바인드 주소. **서버의 사설 NIC 주소**를 넣는다(`ip -br addr` 로 확인).
# VPN 에서 열람하고 앱 컨테이너도 붙어야 하므로 루프백으론 부족하고,
# 0.0.0.0 으로 열면 공인 경로까지 열린다. 미설정 시 127.0.0.1 로 닫힌다.
REDIS_BIND=10.0.0.101

# 호스트 포트. develop 6380 / production 6379 — 한 호스트에 둘 다 뜨므로 갈라 쓴다.
REDIS_PORT=6379
