# production Elasticsearch. 이 폴더를 서버로 가져간 뒤 .env 로 복사한다.
#
#   cp .env.example .env
#
# 기동 전 호스트 커널 파라미터도 필요하다(컨테이너에서 못 바꾼다):
#   sudo sysctl -w vm.max_map_count=262144

# elastic 유저 비밀번호. 없으면 기동을 거부한다.
ELASTIC_PASSWORD=

# 바인드 주소. **이 서버의 사설 NIC 주소**를 넣는다(`ip -br addr`).
# 앱이 다른 호스트에 있으므로 루프백이면 못 붙는다. 미설정 시 127.0.0.1 로 닫힌다.
ELASTICSEARCH_BIND=10.1.0.11

# 호스트 포트.
ELASTICSEARCH_PORT=9200
