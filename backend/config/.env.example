# backend: example

# 환경별 설정. 환경마다 디렉터리를 두고 그 안에 <환경>.env 를 둔다. APP_ENV 또는 --env 로 고른다.
# (파일명은 항상 .env 로 끝나고 앞에 점이 없다. env 뿐 아니라 인증서 같은 다른 매체도
#  그 환경 디렉터리에 모은다.)
#   config/local/local.env         로컬 도커 MySQL (backend/docker-compose.yml)
#   config/develop/develop.env     공유 개발 DB
#   config/production/production.env  운영
#
# 이 파일(config/.env.example)만 git 에 커밋된다. 실제 값이 든 파일은 커밋하지 않는다.
#
# 사용:
#   hansapi-cli --env dev db status
#   APP_ENV=develop pnpm dev:server
#
# --- 설정은 계층으로 쌓인다 (Spring 의 application.yml + application-{profile}.yml 과 같은 방식) ---
# 위에 있는 것이 이긴다. 아래는 채워지지 않은 값만 메꾼다.
#
#   1. process.env         컨테이너·CI 가 주입한 환경변수  ← 파일이 절대 못 덮는다
#   2. ENV_FILE            배포에서 지정한 절대경로 (선택)
#   3. <환경>.local.env    개인 오버라이드 (gitignore)
#   4. <환경>.env          특정 환경에서만 불러들이는 설정
#   5. .env                환경 무시하고 항상 불러들이는 설정 (비밀 포함 가능, gitignore)
#
# 파일이 하나도 없어도 된다. 쿠버네티스처럼 환경변수를 직접 주입하는 배포에서는
# env 파일이 이미지에 들어가지 않기 때문이다. 대신 필수 키(DATABASE_URL, LOG_DATABASE_URL)가
# 비어 있으면 부팅을 거부한다.
#
# --- config/local/local.env 만드는 법 ---
# 로컬 DB 접속값은 비밀이 아니라 컨테이너 고정값이다. 아래를 그대로 복사해
# config/local/local.env 로 쓰면 된다. (KRDATA_SERVICE_KEY 만 본인 키로 채운다)
#
#   DATABASE_URL="mysql://local_hansapi:local_hansapi@127.0.0.1:13306/local_hansapi"
#   LOG_DATABASE_URL="mysql://local_hansapi:local_hansapi@127.0.0.1:13306/local_hansapi_log"
#   SHADOW_DATABASE_URL="mysql://local_hansapi:local_hansapi@127.0.0.1:13306/local_hansapi_shadow"
#
#   cd backend && docker compose up -d   # 로컬 도커 스택(MySQL+Redis+ES) 기동
#   APP_ENV=local pnpm dev:server

# 메인 DB
# Prisma 는 JDBC 스타일 파라미터(useSSL, serverTimezone 등)를 지원하지 않으므로 제거한 형태로 기입한다.
DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"

# 로그 DB. 보존기간·관리 주기가 달라 메인 DB 와 분리돼 있다.
LOG_DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>_log"

# prisma migrate 전용 shadow DB.
# DB 계정에 CREATE DATABASE 권한이 없어 Prisma 가 shadow DB 를 스스로 만들지 못하므로
# 미리 만들어 둔 DB 를 지정한다. migrate 를 돌릴 때마다 Prisma 가 통째로 비우므로
# 실제 데이터를 절대 넣지 말 것. 운영 환경에는 필요 없다(deploy 는 shadow DB 를 쓰지 않는다).
SHADOW_DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>_shadow"

# 공공데이터포털(data.go.kr) 서비스키. 포털이 주는 "Encoding" 키를 그대로 넣는다.
KRDATA_SERVICE_KEY=

# 도로명주소 개발자센터(juso.go.kr) 검색 API 승인키(confmKey). @kr-go/juso 가 쓴다.
# 관리자/배치 계층이 부팅할 때 필수다 — 비어 있으면 부팅을 거부한다.
KRGO_JUSO_SERVICE_KEY=

# 서울열린데이터광장(openapi.seoul.go.kr) 인증키.
# **지금은 아무도 쓰지 않는다.** @seouldata/subway 를 껍데기로 남겨 뒀을 뿐이고,
# 지하철역 사전은 backend/data 의 국가철도공단 엑셀로 만든다. (clients/README.md 참고)
# 비워 둬도 부팅에 지장이 없다.
SEOULDATA_SERVICE_KEY=

# 검색 Elasticsearch (@hansapi/search). CLI 의 `es *` 커맨드가 쓴다.
# ES 없이 떠야 하는 계층(서버)은 이 설정을 요구하지 않는다 — search 계층만 검증한다.
#
# 자격증명은 URL 에 담는다(DATABASE_URL 과 같은 방식). username/password 를 따로 두지 않는다.
#   로컬   : http://127.0.0.1:9200                 (로컬 ES 는 보안 꺼서 계정 불필요)
#   develop: http://elastic:<password>@10.0.0.111:9200   (WireGuard 내부망 + elastic 계정)
# 비밀번호에 @:/ 등이 있으면 퍼센트 인코딩한다(DATABASE_URL 과 동일).
ELASTICSEARCH_URL="http://elastic:password@10.0.0.111:9200"
# 대량 색인 배치 크기(keyset 페이지·bulk 묶음). 인덱스와 무관한 전역 값. 기본 1000.
# (인덱스 alias 같은 인덱스별 이름은 env 가 아니라 코드 상수다 — 인덱스가 늘면 설정이 불어나므로.)
ELASTICSEARCH_BATCH_SIZE=1000
# 정본 스키마 JSON 디렉터리. **비우면 패키지 동봉본**을 쓴다.
# 운영에서 리빌드 없이 스키마만 고쳐 재적용하려면 배포 경로의 편집 가능한 자리를 가리킨다.
# 그 파일만 고치고 `hansapi-cli es schema import` 를 다시 돌리면 된다(코드에 안 박혔으므로).
#   예: ELASTICSEARCH_SCHEMA_DIR=/home/deploy/hansapi/config/elasticsearch
ELASTICSEARCH_SCHEMA_DIR=

# ── 인증(@hansapi/auth-application) ─────────────────────────────────────────
# 인증 테이블은 멀티파일 스키마(prisma/main/auth.prisma, prisma/log/auth.prisma)로 분리돼 있지만
# **기존 DB·커넥션을 그대로 공유**한다 → 별도 DB URL 이 없다(DATABASE_URL/LOG_DATABASE_URL 재사용).
# 나중에 인증을 독립 서비스로 뗄 때 그 파일들을 별도 DB 로 옮기면 된다.

# access token(JWT, HS256) 서명 비밀키. **필수.** 없으면 서버가 부팅하지 않는다.
# 충분히 긴 무작위 문자열을 쓴다(예: openssl rand -base64 48).
AUTH_JWT_SECRET=

# 인증 프론트(plzhans.com)·개발서버 등 토큰 없이 로그인/가입을 호출하는 오리진 허용목록(콤마구분).
# 이게 없으면 CORS 에서 막힌다(로그인 요청엔 토큰이 없으므로). 개발은 vite 기본 5173.
#   AUTH_ALLOWED_ORIGINS=http://localhost:5173,https://plzhans.com
AUTH_ALLOWED_ORIGINS=

# 토큰·보존 만료값(초/일). 비우면 기본값을 쓴다.
#   AUTH_ACCESS_TOKEN_TTL_SEC   access token 만료(초). 기본 3600(1시간)
#   AUTH_REFRESH_TOKEN_TTL_SEC  refresh token 만료(초). 기본 5184000(60일). rotate 마다 연장(sliding)
#   AUTH_CODE_TTL_SEC           소셜 릴레이 인가코드 만료(초). 기본 30
#   AUTH_EMAIL_VERIFY_TTL_SEC   이메일 인증 토큰 만료(초). 기본 86400(24시간)
#   AUTH_PASSWORD_RESET_TTL_SEC 비밀번호 재설정 토큰 만료(초). 기본 3600(1시간)
#   AUTH_WITHDRAWAL_RETENTION_DAYS  탈퇴 기록 보존일수(이후 배치 정리·이메일 재사용). 기본 30
#   AUTH_BCRYPT_ROUNDS          bcrypt 코스트. 기본 10
AUTH_ACCESS_TOKEN_TTL_SEC=3600
AUTH_REFRESH_TOKEN_TTL_SEC=5184000

# API 접근 인증(서비스 키·클라이언트) 조회 캐시 TTL. 인증마다 DB 를 때리지 않기 위한 2단 캐시다.
#   프로세스 메모리 → 공유 캐시 Redis → DB
#
# **TTL 을 짧게 두는 게 안전장치다.** 무효화(키 삭제·재발급)와 조회가 겹치면 조회가 옛 값을 캐시에
# 다시 심을 수 있는데(cache-aside 경쟁), 그 피해가 TTL 안에서 자가 치유된다. 키 하나당 10분에
# DB 1회 수준이라 부하도 아니다. 늘리면 그만큼 폐기된 키가 살아 있을 수 있으니 주의.
#
#   AUTH_ACCESS_CACHE_MEMORY_TTL_SEC  프로세스 메모리 TTL(초). 기본 300(5분).
#     인스턴스마다 따로라, 키 삭제·재발급이 다른 인스턴스에 퍼지는 지연이 곧 이 값이다.
#   AUTH_ACCESS_CACHE_MEMORY_MAX      프로세스 메모리 최대 엔트리 수. 기본 10000(초과 시 LRU 축출).
#     존재하지 않는 키도 "없음"으로 캐싱하므로, 상한이 없으면 무작위 조회만으로 메모리가 계속 는다.
#   AUTH_ACCESS_CACHE_SHARED_TTL_SEC  공유 캐시(Redis) TTL(초). 기본 600(10분).
#     REDIS_URL 이 없으면 공유 캐시 없이 메모리만으로 동작한다.
AUTH_ACCESS_CACHE_MEMORY_TTL_SEC=300
AUTH_ACCESS_CACHE_MEMORY_MAX=10000
AUTH_ACCESS_CACHE_SHARED_TTL_SEC=600

# refresh 쿠키 보안 옵션. 운영(HTTPS)에서는 true → Secure + SameSite=None(크로스 오리진 SPA).
# 기본(미설정/false)은 개발 편의를 위해 SameSite=Lax + 비Secure.
AUTH_COOKIE_SECURE=false

# 소셜 로그인(google/naver/kakao/line). **provider 별 client id/secret 이 둘 다 있어야 활성**된다.
# 하나라도 없으면 그 provider 전략을 등록하지 않는다 — 서버는 그대로 뜨고, 그 provider 만 404 다.
#
# redirect_uri 는 별도 env 없이 **요청이 들어온 호스트에서** 조립된다: {scheme}://{host}/auth/:provider/callback.
# 각 provider 콘솔에는 실제 서비스 도메인 기준으로 등록한다(예: https://api.example.com/auth/google/callback).
# 로그인 후 복귀 URL 은 프론트가 return_to 쿼리로 넘기며, AUTH_ALLOWED_ORIGINS 오리진만 허용된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오는 **REST API 키**를 client_id(KAKAO_CLIENT_ID) 로 쓴다(JS 키 아님). Client Secret 은 선택
# (콘솔 '카카오 로그인 > 보안'에서 켰을 때만 KAKAO_CLIENT_SECRET 에 넣는다).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# LINE 은 콘솔의 앱이 'Channel' 이다. Channel ID/Secret 을 CLIENT_ID/SECRET 로 넣는다(다른 provider 와 이름 통일).
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
