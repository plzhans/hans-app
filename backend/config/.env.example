# config/.env.<환경> 예시. 이 파일만 커밋된다(실제 값은 gitignore, sops .enc 로 커밋).
#
# **여기에는 비밀값만 둔다.** 정책·기본값은 전부 config/config.yaml 에 있고 설명도 거기 있다.
#
# 파일 계층 (아래가 이긴다)
#   config/.env                항상 로드
#   config/.env.<환경>          APP_ENV 로 고른다
#   config/.env.<환경>.local    개인 오버라이드 (gitignore)
#   process.env                컨테이너·CI 주입
#
# 이름은 yaml 경로를 대문자로 편 것이다(auth.jwt.secret → AUTH_JWT_SECRET).
# 규칙과 다른 이름(KRGO_*·APP_SECRET_ENCRYPTION_KEY_V1)은 yaml 에 `${VAR}` 로 그렇게 적혀 있다.
#
# 빈값(`VAR=`)과 미설정(줄 없음)은 다르다. 기본값으로 되돌리려면 줄째로 지운다.

# ── 필수 ──────────────────────────────────────────────────────────────────────
# 없으면 부팅을 거부한다.

# hansapp-api · hansapp-admin-api · hansapp-batch · hansapp-cli
DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"
DATABASE_LOG_URL="mysql://<user>:<password>@<host>:3306/<database>_log"

# hansapp-api
# 토큰·소셜 state·OTP pepper 서명키.  openssl rand -base64 48
AUTH_JWT_SECRET=
# AI 답변 서명키(HMAC-SHA256).  openssl rand -base64 48
LLM_ANSWER_SIGNING_KEY=
# DB 에 저장한 외부 자격증명을 잠그는 마스터 키(AES-256-GCM). 32바이트 base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 교체는 _V2 를 더하는 것이고 이 값은 지우지 않는다. 환경마다 다른 값을 쓴다.
APP_SECRET_ENCRYPTION_KEY_V1=

# hansapp-admin-api
# 관리자 토큰 서명키. **AUTH_JWT_SECRET 과 달라야 한다** — 같으면 부팅을 거부한다.
ADMIN_JWT_SECRET=

# ── 인프라 ────────────────────────────────────────────────────────────────────
# 자격증명은 URL 에 담는다. 비밀번호에 @:/ 가 있으면 퍼센트 인코딩.
# 배포 환경의 <host> 는 compose 서비스 이름(redis)이고, 로컬은 127.0.0.1 이다.
REDIS_URL="redis://:<password>@<host>:6379"
# search 계층만 요구한다. 없으면 그 계층만 안 뜨고 서버는 뜬다.
ELASTICSEARCH_URL="http://elastic:<password>@<host>:9200"

# migrate 전용 shadow DB(매번 통째로 비움 — 실데이터 금지). local 만 필요하다.
DATABASE_SHADOW_URL="mysql://<user>:<password>@<host>:3306/<database>_shadow"

# ── 선택 ──────────────────────────────────────────────────────────────────────

# access token 비대칭(ES256) 키 디렉터리. 미설정이면 HS256(AUTH_JWT_SECRET) 폴백.
#   생성: pnpm hansapp-cli jwt gen   노출: /.well-known/jwks.json
#AUTH_JWT_KEY_DIR=config/develop/jwt

# 첫 관리자 계정 자동 생성. production 은 켜도 코드가 거부한다.
# PASSWORD 를 비우면 난수를 만들어 부팅 로그에 한 번 찍는다.
#ADMIN_BOOTSTRAP_ENABLED=true
#ADMIN_BOOTSTRAP_EMAIL=admin@example.com
#ADMIN_BOOTSTRAP_NAME=관리자
#ADMIN_BOOTSTRAP_PASSWORD=

# DB 설정과 무관하게 메일 발송을 막는다(본문은 콘솔로). 배포 환경에서는 켜지 말 것.
#MAIL_FORCE_DISABLED=true

# 서버 기동·종료 슬랙 알림. 셋 다 없으면 알림만 꺼진다.
# 봇 토큰 발급: 슬랙 앱 → OAuth & Permissions → chat:write → Install → xoxb-
#SLACK_BOT_TOKEN=
#SLACK_CHANNEL=
#SLACK_WEBHOOK_URL=

# ── 외부 서비스 키 ────────────────────────────────────────────────────────────
# **대부분 DB(env_setting)로 옮겼다.** 관리자 → 설정 → 외부 연동 에서 넣는다.
# 아래는 아직 파일에 남아 있는 것들이다.

# 공공데이터 포털(data.go.kr)이 주는 "Encoding" 서비스키. NTS 사업자등록도 이 키를 쓴다.
#KRDATA_SERVICE_KEY=
# 국토교통부 브이월드(vworld.kr) 인증키. 공공데이터 포털과 별개 발급이다.
#KRGO_MOLIT_VWORLD_SERVICE_KEY=
# 도로명주소(juso.go.kr) 검색 API 승인키(confmKey).
#KRGO_JUSO_SERVICE_KEY=
