# backend: config/.env.<환경> 예시. 이 파일만 커밋된다(실제 값 파일은 gitignore, sops .enc 로 커밋).
#
# ┌─ 설정 구조 ────────────────────────────────────────────────────────────────┐
# │ yaml(config/config.<환경>.yaml)  = 구조·기본값·비밀 아닌 리터럴. 커밋된다.   │
# │ env(config/.env.<환경>)          = 비밀 + "env 에서 꼭 설정하려 뺀" 값.      │
# │ yaml 의 `${VAR}`(기본값 없는 것)만 env 로 주입된다. → **여기엔 그것만 둔다.**  │
# │ `${VAR:-기본값}`·리터럴(issuer·rootDomain·TTL·cache 등)은 yaml 이 가진다.      │
# └────────────────────────────────────────────────────────────────────────────┘
#
# 파일 배치 (env 파일은 config/ 바로 밑에 평면, config/<환경>/ 는 jwt 키 등 에셋 폴더):
#   config/.env                환경 무시하고 항상 로드(공통)
#   config/.env.<환경>          환경별 (예: .env.develop). APP_ENV 로 고른다
#   config/.env.<환경>.local    개인 오버라이드 (gitignore, .enc 없음)
#   config/<환경>/jwt/          환경별 서명 키(에셋)
#
# 사용:  APP_ENV=develop pnpm dev:server   /   pnpm hansapi-cli --env develop db status
#
# 계층 (위가 이긴다):
#   1. process.env          컨테이너·CI 주입 (파일이 못 덮음)
#   2. ENV_FILE             절대경로 지정 (선택)
#   3. .env.<환경>.local     개인 오버라이드
#   4. .env.<환경>           환경별
#   5. .env                 공통
# 파일이 없어도 된다(k8s 등 env 직접 주입). 대신 필수 키(DATABASE_URL 등)가 비면 부팅 거부.

# ── database ──────────────────────────────────────────────────────────────────
# Prisma 는 JDBC 파라미터(useSSL 등) 미지원 → 제거한 형태로. **Prisma migrate 는 yaml 이 아니라
# 스키마의 env("...") 로 이 변수들을 직접 읽는다** — 이름 바꾸면 스키마도 같이 바꿔야 한다.
DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"
DATABASE_LOG_URL="mysql://<user>:<password>@<host>:3306/<database>_log"
# migrate 전용 shadow DB(매번 통째로 비움 — 실데이터 금지). CREATE DATABASE 권한 없어 미리 만들어 지정.
DATABASE_SHADOW_URL="mysql://<user>:<password>@<host>:3306/<database>_shadow"

# ── redis ─────────────────────────────────────────────────────────────────────
# 자격증명은 URL 에 담는다. 비밀번호에 @:/ 등이 있으면 퍼센트 인코딩.
REDIS_URL="redis://:<password>@<host>:6379"

# ── elasticsearch ─────────────────────────────────────────────────────────────
# ES 없이 떠야 하는 계층(서버)은 요구하지 않는다 — search 계층만 검증.
ELASTICSEARCH_URL="http://elastic:<password>@<host>:9200"

# ── auth ──────────────────────────────────────────────────────────────────────
# access token(및 소셜 state·OTP pepper·토큰 HMAC) 대칭 서명 비밀키. **필수.** openssl rand -base64 48.
AUTH_JWT_SECRET=
# access token 비대칭(ES256) 키 디렉터리. 미지정이면 cwd 기준 config/jwt 를 본다(키 있으면 ES256, 없으면 HS256 폴백).
#   키 구조: <kid>_ES256.key(활성 개인키) · retired/<kid>_ES256.pub(로테이션 overlap 공개키). kid=JWK thumbprint.
#   생성: pnpm hansapi-cli jwt gen  (→ config/<환경>/jwt). 배포가 config/jwt 로 평면화.
#   노출: GET /.well-known/jwks.json · /.well-known/openid-configuration
#AUTH_JWT_KEY_DIR=config/develop/jwt
# discovery 의 authorization_endpoint = **프론트(hans-auth) 로그인 URL**. 외부 클라(medifinder)가 참조.
# 운영/로컬은 yaml 에 리터럴로 둔다(도메인 확정). develop 은 포털 도메인 미정이라 env 로 뺐다.
#AUTH_AUTHORIZE_URL=https://auth.example.com/login

# ── api-server (proxy) ────────────────────────────────────────────────────────
# 프록시/CDN(Cloudflare·LB) 뒤일 때만 켠다(로컬/직접노출은 비움 → 소켓 IP). rate limit·세션 IP 를 같이 뽑는다.
# ⚠️ 오리진을 "프록시 트래픽만" 받게 잠가야 한다 — 직접 노출되면 위조로 IP 한도 우회된다.
#   CLIENT_IP_HEADER: 진짜 클라 IP 전용 헤더. Cloudflare=cf-connecting-ip, CloudFront=cloudfront-viewer-address, nginx=x-real-ip.
#   TRUST_PROXY: Express trust proxy = 앞단 프록시 홉 수(1겹=1, 2겹=2). 실제보다 크게 잡으면 위조 XFF 를 신뢰하게 됨.
#CLIENT_IP_HEADER=cf-connecting-ip
#TRUST_PROXY=1

# ── sentry (에러 추적) ─────────────────────────────────────────────────────────
# **여기 없다. env 로 주지 않는다.** DSN 은 이벤트 "전송 전용" 공개 엔드포인트라 비밀이 아니고
# (프론트 번들에도 그대로 박힌다), 이걸로는 아무것도 읽지 못한다. 그래서 yaml 에 리터럴로 고정한다:
#   api-server.sentry.dsn / batch.sentry.dsn   (config/config.<환경>.yaml)
# api-server 와 batch 는 **Sentry 프로젝트가 다르다**(알림 규칙 분리). dsn 이 비면 그 앱은 Sentry 를 끈다.
# environment(local|develop|production)·release(버전+커밋 sha)는 코드가 부팅 때 붙인다.

# ── mail ──────────────────────────────────────────────────────────────────────
# host 가 비면 발송 끄고 콘솔 로깅(개발). port/secure/from 은 yaml 기본값·리터럴.
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# ── 외부 플랫폼 provider (OAuth) ────────────────────────────────────────────────
# clientId/secret 둘 다 있어야 그 provider 활성(하나라도 없으면 그것만 비활성, 서버는 정상).
# redirect_uri 는 요청 호스트에서 조립: {scheme}://{host}/auth/:provider/callback. 콘솔에 실서비스 도메인으로 등록.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오는 **REST API 키**를 clientId 로(JS 키 아님). Secret 은 선택(콘솔 '보안'에서 켰을 때만).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# LINE 은 앱이 'Channel'. Channel ID/Secret 을 넣는다(이름 통일).
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# ── krdata (data.go.kr) ───────────────────────────────────────────────────────
# 포털이 주는 "Encoding" 서비스키. NTS 사업자등록 API 도 이 키 공유.
KRDATA_SERVICE_KEY=
# HIRA(심평원) 상세 API 버전. 미설정이면 기본 버전.
#KRDATA_HIRA_DETAIL_VERSION=2.7

# ── juso (juso.go.kr) ─────────────────────────────────────────────────────────
# 도로명주소 검색 API 승인키(confmKey). 관리자/배치 계층 부팅 필수.
KRGO_JUSO_SERVICE_KEY=
