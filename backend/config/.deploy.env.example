# deploy.sh 가 읽는다. 이 파일을 복사해서 값을 채운다.
#
#   mkdir -p develop && cp .deploy.env.example develop/.deploy.env
#
# **config/<환경>/.deploy.env 는 커밋하지 않는다** (시크릿이 들어간다. .gitignore 의 `.deploy*.env`).
#
# 이름은 GitHub 의 Secrets/Variables 와 **정확히 같다.** 같아야 로컬에서 돌린 것과
# CI 에서 돌아간 것이 같다고 말할 수 있다. 이름이 하나라도 다르면 CI 에서만 빈 값이 된다.
#
# 비밀값은 **내용** 또는 **파일 경로**(이름 뒤에 _FILE)로 준다. CI 는 시크릿으로 내용을 주고,
# 로컬에서는 이미 갖고 있는 파일을 가리키는 편이 낫다 — 키를 한 벌 더 복사해 두면
# 그만큼 새어나갈 자리가 는다.

# ── GitHub Variables (develop 환경) ─────────────────────────────────────────
HANSAPI_DEPLOY_SSH_HOST='ubuntu@10.0.0.101'
HANSAPI_DEPLOY_PATH='~/app/hansapi-develop'

# ── SSH ─────────────────────────────────────────────────────────────────────
HANSAPI_DEPLOY_SSH_PRIVATE_KEY_FILE='~/.ssh/id_rsa'
#HANSAPI_DEPLOY_SSH_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
#...
#-----END OPENSSH PRIVATE KEY-----'

# ── WireGuard ───────────────────────────────────────────────────────────────
# wg-quick 이 그대로 먹는 클라이언트 conf 통째다. 조각(개인키·엔드포인트·AllowedIPs)으로
# 나눠 받지 않는다 — 나누면 VPN 설정이 두 곳에 흩어져 언젠가 어긋난다.
#
# **비워두면 VPN 을 붙이지 않는다.** 로컬에서 이미 사설망에 닿고 있으면(다른 VPN 을 쓰는 등)
# 억지로 올릴 이유가 없다. 오히려 기존 터널과 라우팅이 겹친다.
#
#WIREGUARD_CLIENT_CONF_FILE='~/.config/wireguard/hans-dev.conf'
#WIREGUARD_CLIENT_CONF='[Interface]
#PrivateKey = ...
#Address = 10.0.0.9/32
#
#[Peer]
#PublicKey = ...
#Endpoint = vpn.example.com:51820
#AllowedIPs = 10.0.0.0/24
#PersistentKeepalive = 25'

# ── 선택 ────────────────────────────────────────────────────────────────────
# 앱이 아는 환경은 local | dev | prod 뿐이다. GitHub 의 develop 환경 → dev 다.
APP_ENV='develop'

# 배포 후 서버에서 돌릴 재시작 명령. 없으면 파일만 올리고 재시작하지 않는다.
# 프로세스 관리 방식(systemd/pm2)이 정해지면 채운다.
#HANSAPI_DEPLOY_RESTART_CMD='systemctl --user restart hansapi-server'

# ── 로컬 전용 (CI 에는 없는 값) ──────────────────────────────────────────────
# 번들을 다시 만들지 않고 직전 산출물을 재사용한다. 전송·교체만 반복 테스트할 때 쓴다.
#DEPLOY_SKIP_BUILD='1'

# --- 앱 설정 파일 -------------------------------------------------------------
# 서버의 <배포경로>/.env.<APP_ENV> 로 나간다. 앱은 cwd 기준으로 그 자리를 읽는다.
#
# 로컬에서는 이미 갖고 있는 파일을 가리키는 편이 낫다 — DB 접속정보를 한 벌 더
# 복사해 두면 그만큼 새어나갈 자리가 는다. CI 는 시크릿(HANSAPI_ENV)으로 내용을 준다.
#
# 비워 두면 안 보낸다. 그때는 서버가 이미 갖고 있는 파일을 그대로 쓴다.
HANSAPI_ENV_FILE='config/develop/.env.develop'
