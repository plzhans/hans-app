{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    // 선언 파일(.d.ts)은 만들지 않는다. 이 패키지의 유일한 소비자는 hansapp-api(app)이고
    // app 은 customConditions:["src"] 로 소스를 직접 읽으므로 dist 의 .d.ts 를 쓰지 않는다.
    // passport 믹스인 전략(PassportStrategy)은 pnpm 가상 경로를 참조하는 추론 타입이라
    // .d.ts 로 이름 지을 수 없어 TS2742 를 낸다(런타임 JS emit 에는 영향 없다).
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "moduleResolution": "nodenext",
    // 워크스페이스 패키지를 import 할 때 exports 의 "src" 조건을 켠다 — dist 의 .d.ts 가 아니라
    // 원본 .ts 로 해석돼 편집기의 "정의로 이동" 이 소스로 간다(앱 tsconfig 와 같은 설정).
    "customConditions": ["src"]
  },
  "include": ["src"]
}
