// AI 도메인: 앱이 자기 이름으로 쓰는 LLM 업체 키(BYOK).
// 멀티파일 스키마의 한 조각으로 default.prisma 의 generator·datasource(메인 DB)를 공유한다.
//
// **app.prisma 에 섞지 않는다.** 그 파일은 "이것만 들어내면 개발자 플랫폼을 통째로 이관"
// 하려고 도메인을 한 곳에 모아 둔 것인데, 업체 키는 개발자 플랫폼의 발급물이 아니라
// AI 기능이 쓰는 설정이다 — 앱에 매달려 있을 뿐이다.
//
// **LLM 전용 테이블이다.** 다른 외부 연동의 키는 여기 넣지 않는다. 나누는 이유는 이름이
// 아니라 **비용** 이다 — LLM 은 부를 때마다 돈이 나가서 상한·모델·엔드포인트 같은 부가
// 설정이 자격증명에 딸려 붙는다. 그런 게 없는 연동까지 같은 표에 담으면 열의 절반이 늘
// 비어 있고, 어느 열이 어느 종류에 유효한지를 코드가 외워야 한다.
//
// **앱마다 다른 키인 것이 이 표의 전제다.** 우리 시스템이 쓰는 키(공공데이터포털 서비스키 등)는
// 앱별로 갈릴 이유가 없어 여기 오지 않는다 — 그건 운영이 한 벌 관리하는 값이라 어드민의 몫이다.

/// 앱이 자기 이름으로 쓰는 LLM 업체 키(OpenAI·Anthropic 등).
///
/// **app_api_key 와 저장 방식이 정반대다.** 우리 서비스 키는 들어온 값을 해시해 대조하면
/// 끝이라 SHA-256 만 남기지만, 업체 키는 우리가 업체를 부를 때 **원문이 필요**하다.
/// 그래서 해시가 아니라 서버 키로 **되돌릴 수 있게** 잠가 둔다.
/// 이 테이블이 털리면 남의 업체 계정이 털리는 것이라, 다루는 규칙이 몇 가지 따라붙는다.
///  - 복호화는 업체 호출 직전 한 번뿐이다. 복호화한 값을 로그·응답·예외 메시지에 절대 싣지 않는다.
///  - 화면에는 secretSuffix 만 내려간다. 등록한 본인에게도 원문을 다시 보여주지 않는다.
///  - 조회 API 는 secretEncrypted 를 아예 select 하지 않는다(리포지토리 프로젝션으로 막는다).
///
/// **호스팅 업체(OpenAI·Anthropic·Google)는 앱당 한 행이다.** 여러 개를 두면 "지금 어느 키로
/// 나갔나" 에 답이 둘 이상이 되는데, 그 답은 업체 청구서와 맞춰 봐야 하는 값이라 흐려지면
/// 곤란하다. 교체는 덮어쓰기다.
///
/// **LOCAL 은 예외로 여러 행을 허용한다.** 그쪽은 청구서가 없고, 기계마다 다른 모델을 띄우는
/// 것이 정상 사용이라 "여러 대 중 하나를 고른다" 가 자연스럽다. 구분은 name 이 한다.
model AppLlmKey {
  id Int @id @default(autoincrement())

  appId Int @map("app_id")

  /// 어느 업체 키인가.
  provider LlmProvider

  /// **provider 안에서의 신원.** 호스팅 업체는 앱당 하나뿐이라 늘 빈 문자열이고,
  /// LOCAL 은 여러 대를 붙일 수 있어 사용자가 붙인 이름이 들어간다(`workstation`, `gpu-server`).
  ///
  /// 이 컬럼이 "OpenAI 는 하나, Ollama 는 여러 개" 를 DB 수준에서 강제하는 장치다 —
  /// @@unique([appId, provider, name]) 에서 호스팅 업체는 이름이 늘 같으므로(빈 문자열)
  /// 두 번째 행이 들어가지 못하고, LOCAL 은 이름이 다르면 얼마든지 들어간다.
  /// MySQL 에는 조건부 유니크 인덱스가 없어 이 방식으로 표현한다.
  name String @default("") @db.VarChar(50)

  // ---- 자격증명 ----

  /// 서버 키(env: LLM_KEY_ENCRYPTION_KEY_V{n})로 잠근 업체 키. **해시가 아니다** —
  /// 업체를 부르려면 원문을 되찾아야 한다.
  ///
  /// **LOCAL 은 비어 있을 수 있다.** 사내에 띄운 Ollama 는 대개 인증이 없다 —
  /// 없는 키를 넣으라고 강제하면 더미 값이 들어와 "키가 있다" 는 판정만 흐려진다.
  ///
  /// `v{버전}:{iv}:{tag}:{암호문}` 한 문자열로 담는다(각 조각 base64).
  /// AES-GCM 은 결과가 세 덩어리로 나오는데(암호문·IV·인증태그) 셋 다 있어야 열리므로,
  /// 컬럼을 셋으로 펼치지 않고 붙여 둔다 — DB 에서 볼 일은 "잠긴 값 하나" 뿐이다.
  ///  - iv  : 암호화할 때마다 새로 뽑는 난수. **비밀이 아니다.** 비밀번호 해시에 붙이는
  ///          salt 와 같은 몫이다 — 이게 없으면 같은 업체 키를 등록한 두 앱의 암호문이
  ///          똑같이 나와서, 암호문만 비교해도 같은 계정임이 드러난다.
  ///  - tag : 체크섬. 복호화 때 대조해 DB 에서 값이 바뀌었으면 예외로 터뜨린다.
  ///  - v{n}: 어느 서버 키로 잠갔나. **키를 갈 때 아직 옛 키인 행을 가른다** —
  ///          없으면 교체하는 순간 기존 행을 하나도 못 연다.
  secretEncrypted String? @map("secret_encrypted") @db.VarChar(512)

  /// 표시용 뒤 4자(`sk-…aB3f`). 사용자가 업체 콘솔의 키 목록과 대조할 때 쓰는 유일한 단서다.
  /// **목록 한 번 그리자고 전 행을 복호화하지 않으려고** 따로 둔다. 키가 없으면 null.
  secretSuffix String? @map("secret_suffix") @db.VarChar(8)

  // ---- 접속 ----

  /// 스킴+호스트까지의 엔드포인트. 비우면 서버 설정(llm.{provider}.baseUrl)을 쓴다.
  ///
  ///  - 호스팅 업체: 비워 두는 것이 보통. Azure OpenAI 나 사내 게이트웨이를 끼울 때만 채운다.
  ///  - LOCAL: **사실상 필수다.** 어느 기계의 Ollama 인지가 이 값으로만 갈린다
  ///    (`http://10.0.0.7:11434`). 서비스가 등록 시 검사한다.
  baseUrl String? @map("base_url") @db.VarChar(200)

  /// 이 키로 부를 기본 모델. 비우면 서버 설정(llm.{provider}.defaultModel)을 쓴다.
  /// **모델이 곧 단가다** — 상한과 짝이라 같은 행에 둔다.
  defaultModel String? @map("default_model") @db.VarChar(100)

  // ---- 비용 ----
  //
  // **이 블록이 external key 와 갈리는 이유다.** 부를 때마다 남의 카드에서 돈이 나가므로,
  // 우리 버그나 남용으로 청구서가 터지지 않게 상한을 건다.
  //
  // 단위는 **마이크로 USD 정수**(1_000_000 = $1)다. 부동소수를 쓰지 않는 것은 돈이라서고,
  // 토큰이 아니라 금액인 것은 **사용자가 보는 것이 업체 청구서**이기 때문이다.
  // 토큰↔금액 환산은 모델별 단가표가 한다(코드 쪽. 업체가 단가를 바꾸면 그 표만 고친다).
  //
  // 월·일 두 창을 두는 것은 우리 앱 몫 계수기와 같은 규칙이다 — 월 상한만 있으면
  // 첫날에 한 달치를 태워도 막을 방법이 없다.
  //
  // **LOCAL 에는 의미가 없다**(자기 기계에서 도니 청구서가 없다). 그래서 강제하지 않고
  // null 로 둔다 — 0 을 넣어 "무제한" 을 표현하면 "0원까지만" 과 구분되지 않는다.

  /// 월 상한. null 이면 무제한.
  monthlyLimitMicroUsd Int? @map("monthly_limit_micro_usd")

  /// 일 상한. null 이면 무제한.
  dailyLimitMicroUsd Int? @map("daily_limit_micro_usd")

  /// 상한에 걸렸을 때 우리 키로 넘어갈지. 기본은 **넘어가지 않는다**(거절).
  /// 켜 두면 상한이 "여기까지만 내 돈" 이라는 뜻이 되고, 꺼 두면 "여기까지만 쓴다" 가 된다.
  fallbackToService Boolean @default(false) @map("fallback_to_service")

  // ---- 상태 ----

  /// 이 키가 실제로 통했나. **등록할 때는 확인하지 않는다** — 업체마다 확인 방법이 다르고,
  /// 사내망 Ollama 는 우리 서버에서 닿지도 않으며, 200 이 와도 잔액까지는 알 수 없어
  /// "확인됨" 이 약속을 넘겨 버린다. 그래서 등록은 늘 UNVERIFIED 로 시작하고,
  /// **첫 실사용의 결과**가 이 값을 정한다(성공 VALID / 401·403 INVALID).
  verifyState LlmKeyVerifyState @default(UNVERIFIED)

  /// 마지막으로 판정한 시각. 업체가 키를 폐기하면 VALID 였던 것도 나중에 INVALID 가 된다.
  verifiedAt DateTime? @map("verified_at")

  /// 실패한 이유(업체 응답 요약). 화면이 "왜 안 되는지" 를 말해 주는 유일한 단서다.
  /// **키 값은 절대 담지 않는다.**
  verifyError String? @map("verify_error") @db.VarChar(200)

  /// 끌 수 있게 둔다. 지우지 않고 잠깐 우리 키로 되돌리고 싶을 때가 있다.
  /// **AppStatus 를 재사용하지 않는다** — 남의 업체 키에 PENDING(심사 대기)이라는 상태가 없다.
  enabled Boolean @default(true)

  /// 이 키로 업체를 마지막으로 부른 시각. 안 쓰는 키를 골라내는 데 쓴다.
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  /// **호스팅 업체는 앱당 하나, LOCAL 은 이름만 다르면 여럿.** name 주석 참고.
  /// 조회도 이 조합으로 들어오므로 별도 인덱스가 필요 없다.
  @@unique([appId, provider, name])
  @@map("app_llm_key")
}

/// LLM 업체. 설정의 `LlmProviderName`('anthropic' | 'openai' | 'local')과 짝이라
/// 값을 그대로 넘길 수 있다.
///
/// **LOCAL 은 OpenAI 호환 엔드포인트를 뜻한다** — Ollama·vLLM·LM Studio. 업체가 아니라
/// "사용자가 띄운 서버" 라서 앞의 셋과 성격이 다르다: 키가 없을 수 있고, baseUrl 이 신원이며,
/// 여러 대를 붙일 수 있고, 비용 상한이 의미가 없다.
enum LlmProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  LOCAL
}

enum LlmKeyVerifyState {
  /// **아직 써 본 적이 없다.** 등록 직후의 상태다. 판정 호출이 업체 사정(429·타임아웃)으로
  /// 실패했을 때도 여기로 되돌린다 — 우리가 못 물어본 것을 "키가 틀렸다" 로 적으면 안 된다.
  UNVERIFIED
  /// 이 키로 실제 호출이 성공했다.
  VALID
  /// 업체가 거절했다(401·403). 키가 틀렸거나 폐기됐거나 권한이 없다.
  INVALID
}
