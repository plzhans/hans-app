// 커뮤니티 도메인: 게시판(Board) + 게시글(BoardPost) + 댓글(BoardComment).
// 멀티파일 스키마의 한 조각으로 default.prisma 의 generator·datasource(메인 DB)를 공유한다.
//
// **이 파일만 들어내면 커뮤니티 스키마를 통째로 이관**할 수 있게 도메인을 한 파일에 모은다.
// 다른 도메인(auth 의 User, admin 의 AdminUser)은 relation 없이 id 로만 가리킨다 — 회원을
// 지우는 일과 글을 지우는 일이 서로를 끌고 다니면 안 된다.
//
// **DB enum 을 쓰지 않는다.** 값 하나 늘 때마다 ALTER TABLE 이 따라오고, 배포 순서까지
// 맞춰야 한다 — 코드는 새 값을 아는데 DB 는 모르는 구간이 생긴다. 허용 값은 코드가 정한다
// (@hansapp/common 의 BOARD_* 상수).
//
// **표의 크기에 따라 담는 모양이 다르다.**
//  - board(게시판)  몇 행뿐이라 **문자열** 그대로 둔다. DB 를 열어 봤을 때 바로 읽힌다.
//  - board_post·board_comment  계속 쌓이는 표라 **숫자 코드(TINYINT)** 로 담는다.
//    문자열이면 행마다 그 길이를 물고 가고 인덱스도 그만큼 커진다.
//    사람이 읽는 이름으로 바꾸는 것은 응답을 만드는 자리 한 곳이 한다(API 는 이름을 준다).

/// 게시판. 공지사항·자료실처럼 글을 모아 두는 단위이며, 게시판마다 규칙이 다르다.
///
/// **id 가 아니라 name 으로 가리킨다.** 포털 주소가 `/board/notice` 처럼 읽히고, 번호를
/// 노출하면 게시판이 몇 개인지·언제 만들어졌는지가 그대로 드러난다.
///
/// name 은 기계가 쓰는 이름, title 은 사람이 읽는 이름이다.
///
/// **기능은 전부 게시판이 정한다.** 누가 쓰나(writeRole)·댓글을 받나(commentEnabled)·
/// 비공개 글/댓글을 허용하나(secret*Enabled). 글과 댓글에도 같은 이름의 스위치가 있지만
/// 그것들은 **게시판이 켠 범위 안에서만** 의미가 있다 — 상위가 꺼져 있으면 하위 설정은
/// 무시된다. 그래야 게시판 설정 하나만 보고 그 게시판이 어떤 곳인지 말할 수 있다.
model Board {
  id Int @id @default(autoincrement())

  /// 주소·API 에서 이 게시판을 가리키는 이름(notice, faq …). 소문자·숫자·하이픈만.
  name String @unique @db.VarChar(50)

  /// 화면에 보이는 이름
  title String @db.VarChar(100)

  /// 게시판 설명. 목록 위에 한 줄로 붙는다.
  description String? @db.VarChar(500)

  /// 글을 쓸 수 있는 사람. ADMIN=운영자만, MEMBER=로그인한 회원도.
  ///
  /// **게시판마다 다르다.** 공지사항은 운영자만 쓰고 자유게시판은 회원이 쓴다 — 이 한 값이
  /// 그 차이를 정한다. 회원 글을 받는 게시판이 생기면 신고·숨김이 따라와야 하므로,
  /// MEMBER 로 여는 것은 그 준비가 된 뒤에 한다.
  writeRole String @default("ADMIN") @map("write_role") @db.VarChar(20)

  /// 이 게시판에서 댓글을 쓸 수 있나.
  ///
  /// **끄면 글마다의 설정과 무관하게 댓글이 없다.** 게시판이 상위 스위치다 — 댓글을 닫기로
  /// 한 게시판에 글 설정만으로 댓글이 열리면, 게시판 설정이 거짓말이 된다.
  commentEnabled Boolean @default(false) @map("comment_enabled")

  /// 비공개 글을 쓸 수 있나. 켜야 BoardPost.secret 을 세울 수 있다.
  ///
  /// **기본은 꺼짐이다.** 공지사항처럼 모두에게 보여야 하는 게시판에 비공개 글이 생기면
  /// 그 게시판의 뜻이 흐려진다 — 문의 게시판처럼 필요한 곳에서만 켠다.
  secretPostEnabled Boolean @default(false) @map("secret_post_enabled")

  /// 비공개 댓글을 쓸 수 있나. 켜야 BoardComment.secret 을 세울 수 있다.
  /// commentEnabled 가 꺼져 있으면 이 값은 아무 뜻이 없다(댓글 자체가 없다).
  secretCommentEnabled Boolean @default(false) @map("secret_comment_enabled")

  /// 좋아요를 받는 게시판인가. 댓글과 같은 결의 상위 스위치다.
  likeEnabled Boolean @default(false) @map("like_enabled")

  /// 공개 여부. HIDDEN 은 공개 API 에서 사라지고 콘솔에서만 보인다.
  status String @default("ACTIVE") @db.VarChar(20)

  /// 목록에서의 순서. 작은 값이 앞이고, 같으면 id 순.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts BoardPost[]

  @@map("board")
}

/// 게시글.
///
/// **본문은 마크다운이다.** 에디터(TOAST UI)가 마크다운으로 주고받고, 화면은 그것을 렌더한다.
/// HTML 을 그대로 저장하면 저장된 문자열 자체가 실행 가능한 것이 되어, 어디서 지워야 하는지가
/// 흐려진다 — 마크다운은 렌더하는 자리 한 곳만 지키면 된다.
model BoardPost {
  id Int @id @default(autoincrement())

  boardId Int   @map("board_id")
  board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  title String @db.VarChar(200)

  /// 본문(마크다운).
  content String @db.Text

  /// 목록에 뿌릴 한 줄 요약. 비면 본문에서 뽑는다.
  summary String? @db.VarChar(300)

  /// 쓴 사람. 타입·번호·표시 이름 세 값이 한 벌이다(→ BoardAuthorType).
  authorType Int    @map("author_type") @db.TinyInt
  authorId   Int    @map("author_id")
  authorName String @map("author_name") @db.VarChar(100)

  /// 이 글에 댓글을 받을지. **null 이면 게시판 설정을 따른다**(기본값).
  ///
  /// 저장할 때 게시판 값으로 잘라 두면, 나중에 게시판에서 댓글을 켜도 그전에 쓴 글은 꺼진
  /// 채로 남는다 — 글을 하나하나 고칠 수는 없다. 그래서 **글은 자기 뜻만 적고**(따름/허용/불가),
  /// 실제로 열리는지는 읽을 때 계산한다: `board.commentEnabled && (post.commentEnabled ?? true)`.
  commentEnabled Boolean? @map("comment_enabled")

  /// 이 글에 좋아요를 받을지. 댓글과 같은 규칙(null = 게시판 따름).
  likeEnabled Boolean? @map("like_enabled")

  /// 비공개 글인가.
  ///
  /// **본문을 볼 수 있는 사람은 쓴 사람과 운영자뿐이다.** 목록에는 남지만 제목만 보이고,
  /// 본문은 응답에 담기지 않는다(댓글의 secret 과 같은 규칙). 게시판의
  /// secretPostEnabled 가 꺼져 있으면 세울 수 없다.
  secret Boolean @default(false)

  /// 목록 맨 위에 고정. 공지에 쓴다.
  pinned Boolean @default(false)

  /// DRAFT(작성 중)·PUBLISHED(공개)·HIDDEN(내림). 공개 API 는 PUBLISHED 만 본다.
  status Int @default(2) @db.TinyInt

  /// 공개된 시각. **createdAt 과 다르다** — 써 두고 나중에 공개하면 그때가 이 값이다.
  /// 목록 정렬의 기준이라, 공개 상태인데 비어 있으면 안 된다(서비스가 채운다).
  publishedAt DateTime? @map("published_at")

  viewCount Int @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comments BoardComment[]

  /// 목록 조회: 게시판 안에서 고정 글 먼저, 그다음 공개일 역순.
  @@index([boardId, status, pinned, publishedAt])
  @@map("board_post")
}

/// 댓글. 한 단계 답글까지만 받는다(parentId).
///
/// **트리를 깊게 두지 않는다.** 깊이가 늘면 화면도 쿼리도 복잡해지는데, 공지·문의에 달리는
/// 댓글은 대개 한 번 주고받고 끝난다. 필요해지면 그때 깊이를 연다.
model BoardComment {
  id Int @id @default(autoincrement())

  postId Int       @map("post_id")
  post   BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 답글이면 부모 댓글. 최상위는 null.
  parentId Int?           @map("parent_id")
  parent   BoardComment?  @relation("BoardCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  BoardComment[] @relation("BoardCommentReplies")

  content String @db.Text

  /// 비공개 댓글인가.
  ///
  /// **내용을 볼 수 있는 사람은 셋뿐이다** — 쓴 사람, 글쓴이, 그리고 운영자. 나머지에게는
  /// "비공개 댓글입니다" 만 보이고 본문은 **응답에 아예 담기지 않는다**. 화면에서 가리는
  /// 방식으로는 개발자도구를 여는 순간 다 읽힌다.
  ///
  /// 댓글이 있다는 사실과 쓴 시각까지 감추지는 않는다. 그것까지 지우면 답글 수·순서가
  /// 어긋나 대화가 이상해진다.
  secret Boolean @default(false)

  /// 쓴 사람. 글과 같은 세 값이다.
  ///
  /// **비공개 댓글이면 이 값이 곧 열쇠다** — 익명으로 받는 자리가 아니라, 누가 썼는지는
  /// 남기고 내용만 가리는 것이다.
  authorType Int    @map("author_type") @db.TinyInt
  authorId   Int    @map("author_id")
  authorName String @map("author_name") @db.VarChar(100)

  /// HIDDEN 은 화면에서 "삭제된 댓글" 로 남는다 — 답글이 달린 댓글을 지우면 대화가 끊긴다.
  status Int @default(1) @db.TinyInt

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postId, status, createdAt])
  @@map("board_comment")
}
