// 인증(계정/토큰) 도메인 모델. 멀티파일 스키마의 한 조각으로, default.prisma 의
// generator·datasource(메인 DB)를 공유한다. → 별도 커넥션/클라이언트를 만들지 않는다.
//
// **이 파일만 따로 들어내면 인증 스키마를 통째로 이관할 수 있게** 도메인을 한 파일에 모아 둔다.
// (공공데이터 도메인과 섞지 않는다.)

/// 회원. 이메일 계정이 기본이고, 소셜 연동도 항상 이 회원에 매핑된다.
/// 회원 규모가 크지 않아 PK 는 Int(회원번호)로 둔다.
model User {
  /// 회원번호
  id Int @id @default(autoincrement())

  /// 로그인·식별용 이메일. 전역 유일. 소셜 가입도 이메일을 받아 채운다.
  email String @unique @db.VarChar(320)

  /// 이메일 소유 검증 여부. 소셜 provider 가 검증된 이메일을 주면 true 로 생성한다.
  emailVerified Boolean @default(false) @map("email_verified")

  /// bcrypt 해시(60자). 소셜 전용 계정은 null.
  password String? @db.VarChar(60)

  /// 표시 이름
  name String? @db.VarChar(100)

  /// 계정 상태. WITHDRAWN 은 탈퇴(로그인 차단). 하드삭제는 30일 뒤 배치가 수행한다.
  status UserStatus @default(ACTIVE)

  /// 권한
  role UserRole @default(USER)

  /// 등급. 앱(App) 생성 한도를 결정한다. UNLIMITED 는 무제한(운영자 계정 등).
  tier UserTier @default(BASIC)

  /// 최초 가입 수단(EMAIL 포함). 이후 다른 소셜을 연동해도 값은 바뀌지 않는다.
  joinType AuthProvider @map("join_type")

  /// 국가(ISO 3166-1 alpha-2 대문자). **어느 나라에서 많이 쓰는지 집계하려고 받아 둔다** —
  /// 브라우저가 국가를 알려 주지 않아 가입 시점의 타임존에서 되짚은 근사값이다.
  ///
  /// **가입할 때 한 번 적고 끝이다.** 화면에 내보내지도, 고치게 하지도 않는다 —
  /// 집계 말고는 쓰지 않는 값이라 이용자가 관리할 이유가 없다.
  /// 같은 이유로 권한·과금·법적 고지를 이 값으로 가르지 않는다(근사값으로는 부족하다).
  countryCode String? @map("country_code") @db.Char(2)

  /// 표시·메일 언어. 지원 언어(ko/en/ja/zh)로 좁혀 저장한다. **이용자가 바꿀 수 있다.**
  /// 비어 있으면 그때그때 요청의 Accept-Language 로 떨어진다.
  language String? @db.VarChar(2)

  /// IANA 타임존 ID(예: Asia/Seoul). **이용자가 바꿀 수 있다.**
  ///
  /// **오프셋(GMT+9)을 저장하지 않는다.** 서머타임을 쓰는 지역은 1년에 두 번 값이 달라지고,
  /// 같은 오프셋에 여러 나라가 겹쳐 되짚을 수도 없다. 존 ID 를 두고 표시할 때 계산한다.
  timeZone String? @map("time_zone") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// 탈퇴 시각(status=WITHDRAWN 이 된 시점). 활성 계정은 null.
  withdrawnAt DateTime? @map("withdrawn_at")

  oauths         UserOAuth[]
  consents       UserConsent[]
  sessions       UserTokenSession[]
  authCodes      UserAuthCode[]
  appMemberships AppMember[]

  @@map("user")
}

/// 계정 ↔ 외부 소셜 연동 매핑(1:N). 한 회원이 여러 provider 를 붙일 수 있다.
model UserOAuth {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")

  /// 소셜 provider
  provider OAuthProvider

  /// provider 가 준 고유 식별자(OIDC subject / provider user id)
  providerId String @map("provider_id") @db.VarChar(191)

  /// provider 가 준 이메일(참고용, 검증 여부는 provider 마다 다름)
  email String? @db.VarChar(320)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 같은 소셜 계정은 한 번만 연동된다.
  @@unique([provider, providerId])
  @@index([userId])
  @@map("user_oauth")
}

/// 이메일 인증 코드(OTP). **가입 전(계정 없음) 단계에서도 쓰므로 userId 가 아니라 이메일로 키한다.**
///
/// 미가입 이메일이 평문으로 쌓이면 유출 시 수집 대상이 되므로, 이메일도 코드도 **원문을 저장하지 않고**
/// 서버 pepper 로 HMAC-SHA256 한 해시만 둔다(엔트로피가 낮아 평범한 SHA-256 은 사전 대입에 뚫린다).
/// 발송 이력이자 검증 상태 저장소다 — 시간당 발송 상한도 이 테이블의 created_at 으로 센다.
model EmailVerification {
  id Int @id @default(autoincrement())

  /// HMAC-SHA256(정규화 이메일, pepper) hex 64자. 조회·시간당 카운트 키. 평문 이메일은 저장하지 않는다.
  emailHash String @map("email_hash") @db.Char(64)

  /// 용도(가입/비밀번호 재설정)
  purpose EmailVerifyPurpose

  /// HMAC-SHA256(코드, pepper) hex 64자. 코드 원문은 저장하지 않는다.
  codeHash String @map("code_hash") @db.Char(64)

  /// 검증 시도 횟수. 상한 초과 시 코드를 폐기(소비 처리)한다.
  attempts Int @default(0)

  expiresAt  DateTime  @map("expires_at")
  /// 사용(소비) 시각. 성공·시도초과·재발송 시 채워 재사용을 막는다.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// 조회(용도별 최신 활성 코드)
  @@index([emailHash, purpose])
  /// 시간당 발송량 카운트
  @@index([emailHash, createdAt])
  @@map("email_verification")
}

/// refresh 세션. 불투명 refresh 토큰의 서버측 저장소.
/// 토큰 원문은 저장하지 않고 secret 의 SHA-256 해시만 둔다. rotate 시 만료를 연장한다(sliding).
model UserTokenSession {
  /// 세션 식별자. refresh 토큰에 내장돼 조회 키로 쓰인다.
  sessionId String @id @map("session_id") @db.VarChar(64)

  userId Int @map("user_id")

  /// SHA-256(secret) hex 64자. rotate 마다 새 secret 으로 교체된다.
  secretHash String @map("secret_hash") @db.Char(64)

  /// 발급 기기 정보(로그인 기기 목록·개별 로그아웃용)
  userAgent String? @map("user_agent") @db.VarChar(255)
  ip        String? @db.VarChar(45)

  /// 만료 시각. rotate 마다 갱신(연장)된다.
  expiresAt DateTime @map("expires_at")

  /// 로그인할 때 "로그인 상태 유지" 를 켰나.
  ///
  /// **쿠키를 영속으로 심을지 세션 쿠키로 심을지를 정한다.** 켜면 만료 시각이 박힌 쿠키라
  /// 브라우저를 닫아도 남고, 끄면 세션 쿠키라 브라우저를 닫을 때 사라진다.
  ///
  /// 갱신(rotate) 때 쿠키를 다시 심는데, 그 시점에는 요청만 보고 원래 선택을 알 수 없다 —
  /// 브라우저는 쿠키가 영속이었는지 알려 주지 않는다. 그래서 세션에 적어 둔다.
  persistent Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_token_session")
}

/// 소셜 콜백 → SPA 프론트로 넘기는 1회용 인가코드(릴레이).
/// 코드 페이로드를 통째로 저장하지 않고 식별자(sid)만 보관해 로우를 최소화한다.
model UserAuthCode {
  /// 코드 식별자
  sid String @id @db.VarChar(32)

  userId Int @map("user_id")

  /// 이 코드를 발급받은 클라이언트(AppClient.clientId). **null 이면 1st-party**(hansapp-web).
  ///
  /// 발급 시점에 서버가 정하므로 위조할 수 없다. 교환(/oauth/token) 때 이 값으로
  /// 요청 Origin 을 대조한다 — null 이면 AUTH_ALLOWED_ORIGINS, 있으면 그 클라이언트의 origins.
  /// 코드가 탈취돼도 다른 출처에서는 교환되지 않는다(RFC 6749 가 client_id 를 묶는 이유).
  clientId String? @map("client_id") @db.VarChar(40)

  /// PKCE(RFC 7636) code_challenge. BASE64URL(SHA256(verifier)) 43자, S256 방식만 받는다.
  ///
  /// 발급 요청이 준 값을 그대로 보관했다가, 교환 때 클라이언트가 보내는 code_verifier 를
  /// 같은 방식으로 해시해 대조한다. **원본(verifier)은 서버가 끝까지 모른다** — 그래서
  /// 이 값이 새어도, DB 가 통째로 털려도 그것만으로는 코드를 교환할 수 없다.
  ///
  /// nullable 인 건 기존 행 때문이다. 새로 발급되는 코드에는 항상 채워진다.
  codeChallenge String? @map("code_challenge") @db.VarChar(128)

  /// **이번 로그인에 실제로 쓴 수단.** 가입 방식(User.joinType)이 아니다 —
  /// 이메일로 가입한 사람이 구글을 연동해 로그인할 수 있고, 그때 남아야 할 값은 GOOGLE 이다.
  ///
  /// 코드를 교환하는 시점에는 그 정보가 없어서(콜백과 교환이 다른 요청이다) 여기에 실어
  /// 나른다. 없으면 로그인 로그가 joinType 으로 근사되어 "오늘 무엇으로 들어왔나" 가 사라진다.
  ///
  /// nullable 인 건 기존 행 때문이다. 새로 발급되는 코드에는 항상 채워진다.
  provider AuthProvider? @map("provider")

  /// 시작 화면에서 고른 "로그인 상태 유지".
  ///
  /// 세션은 콜백이 아니라 **교환(/oauth/token) 시점**에 만들어지는데, 그 요청에는 사용자의
  /// 선택이 없다(다른 요청이고, 화면도 이미 떠났다). 코드가 유일한 운반 수단이라 여기 싣는다.
  ///
  /// 기본이 true 인 건 이 컬럼이 생기기 전 행 때문이다. 새로 발급되는 코드에는 항상 채워진다.
  persistent Boolean @default(true)

  /// SHA-256(secret) hex 64자
  secretHash String @map("secret_hash") @db.Char(64)

  /// 만료 시각(~30초)
  expiresAt DateTime @map("expires_at")
  /// 사용(소비) 시각. 1회용 보장.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_auth_code")
}

/// 가입 시 받은 동의의 기록.
///
/// **동의를 받았다는 입증 책임이 처리자에게 있다.** 화면에 체크박스를 두는 것만으로는
/// 나중에 아무것도 보여줄 수 없어서, 무엇에 · 언제 · 어느 판에 동의했는지를 남긴다.
///
/// 판(version)을 함께 남기는 이유는 개정 때문이다. 약관을 고치면 이용자에게 불리한 변경은
/// 재동의를 받아야 하는데, 이 값이 있어야 **"현재 판보다 낮은 사람에게만"** 다시 물을 수 있다.
/// 전원에게 다시 받으면 이미 동의한 사람까지 붙잡게 된다.
model UserConsent {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")

  /// 무엇에 대한 동의인가
  type ConsentType

  /// 동의한 문서의 판. 문서의 시행일을 그대로 쓴다(예: 2026-08-06).
  /// 연령 확인처럼 문서가 없는 항목은 '-' 를 넣는다.
  version String @db.VarChar(20)

  agreedAt DateTime @default(now()) @map("agreed_at")

  /// 동의 시점의 접속 정보. 다툼이 생겼을 때 그 기록을 특정하는 근거다.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("user_consent")
}

/// 탈퇴 기록. 개인정보 최소 항목만 보관하며, 가입 중복 체크가 이 표도 조회한다.
/// purgeAt 이 지나면 배치가 정리한다(그 시점에 User 하드삭제도 함께 수행) → 이메일 재사용 가능.
model UserWithdrawal {
  id Int @id @default(autoincrement())

  /// 원래 회원번호
  originalUserId Int @map("original_user_id")

  /// 가입 이메일(재가입 차단 조회 키)
  email String @db.VarChar(320)

  /// 이름
  name String? @db.VarChar(100)

  withdrawnAt DateTime @default(now()) @map("withdrawn_at")

  /// 정리(파기) 예정 시각 = withdrawnAt + 30일. 이후 이 행과 User 를 삭제한다.
  purgeAt DateTime @map("purge_at")

  @@index([email])
  @@index([purgeAt])
  @@map("user_withdrawal")
}

/// 계정 상태
enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

/// 권한
enum UserRole {
  USER
  ADMIN
}

/// 등급. 앱 생성 한도를 결정한다(한도 매핑은 애플리케이션 설정). UNLIMITED 는 무제한.
enum UserTier {
  BASIC
  PRO
  UNLIMITED
}

/// 가입/로그인 수단(EMAIL 포함). User.joinType 에 쓴다.
enum AuthProvider {
  EMAIL
  GOOGLE
  NAVER
  KAKAO
  LINE
}

/// 외부 소셜 provider(EMAIL 제외). UserOAuth.provider 에 쓴다.
/// 동의 항목. AGE_14 는 문서가 아니라 이용자의 자기 선언이다
/// (본인확인을 하지 않으므로 나이를 검증하지는 못한다 — 개인정보처리방침 제12조).
enum ConsentType {
  TERMS
  PRIVACY
  AGE_14
}

enum OAuthProvider {
  GOOGLE
  NAVER
  KAKAO
  LINE
}

/// 이메일 인증 코드(OTP) 용도. EmailVerification.purpose 에 쓴다.
/// SIGNUP: 이메일 가입/소셜 미검증 이메일 확정. PASSWORD_RESET: 비밀번호 재설정.
enum EmailVerifyPurpose {
  SIGNUP
  PASSWORD_RESET
}
