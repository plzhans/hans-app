// 배치 실행 이력 모델. 멀티파일 스키마의 한 조각으로, default.prisma 의
// generator·datasource(로그 DB, DATABASE_LOG_URL)를 공유한다.
//
// **마스터는 메인 DB 에 있다**(batch_job, sync_state). 현재 상태는 실행 판정이 매번 읽는
// 값이라 메인에 있어야 한다 — 로그 DB 에 두면 적재가 로그 DB 에 의존하게 된다.
// DB 가 갈려 있어 relation 은 만들 수 없다. 키는 값으로만 들고, 필요하면 raw SQL 로
// 조인한다(같은 MySQL 서버라 가능하다).
//
// **DB enum 을 쓰지 않는다.** 계속 쌓이는 표라 코드는 숫자(TINYINT)로 담는다
// (→ @hansapp/common 의 batch-codes.ts). 이름으로 바꾸는 것은 응답을 만드는 자리가 한다.

/// 잡 한 회차. batch_job(메인 DB)의 과거 상태들이다.
///
/// **여기 답하는 질문은 하나다: 이 잡이 매일 돌았나.** 마스터는 마지막 한 번만 들고
/// 덮어쓰므로 "어제도 그제도 돌았나" 를 모른다.
model BatchJobHistory {
  id BigInt @id @default(autoincrement())

  /// batch_job.job 과 같은 값. daily-sync | auth-cleanup
  job String @db.VarChar(30)

  /// BatchRunSource. **잡 회차에는 CRON | ONCE 만 온다** —
  /// hanscli 에는 "하루치 배치 전체" 커맨드가 없고 단계만 돌기 때문이다.
  source Int @db.TinyInt

  /// BatchRunStatus. 마스터와 달리 IDLE 은 오지 않는다.
  status Int @db.TinyInt

  /// 이 회차가 원래 돌기로 했던 시각(직전 next_run_at).
  ///
  /// startedAt 과의 차이가 곧 지연이다 — 겹침·부하로 밀린 회차가 여기서 보인다.
  /// 사람이 손으로 부른 회차(ONCE)는 예정이 없으므로 null.
  scheduledAt DateTime? @map("scheduled_at")

  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  elapsedMs  Int?      @map("elapsed_ms")

  /// 회차 합계. **잡마다 의미가 다르다** —
  /// daily-sync 는 병원 처리 건수, auth-cleanup 은 삭제 건수다.
  calls     Int @default(0)
  processed Int @default(0)

  error String? @db.Text

  /// 잡마다 모양이 다른 요약(기관별 콜, 테이블별 삭제 건수, 삼킨 실패).
  /// 모양이 잡마다 달라서 열로 못 뽑는 것만 여기 담는다.
  summary Json?

  // ── 누가 돌렸나 ────────────────────────────────────────────────
  //
  // **어디서 도는지 모르는 상태가 실제로 벌어져서 넣었다.** 옛 빌드가 어딘가에 떠서
  // 회차를 계속 만드는데, 이력에 실행 주체가 없어 호스트를 특정하지 못했다.
  // 처음엔 "인스턴스가 하나뿐이라 전부 같은 값" 이라며 뺐는데, 값이 같은 것과
  // 값이 없는 것은 다르다 — 하나뿐이라는 전제가 깨지는 순간 추적할 근거가 사라진다.

  /// 이 회차를 돌린 호스트 이름(os.hostname()).
  hostname String? @db.VarChar(64)

  /// 그 호스트의 프로세스 번호. 같은 호스트에 여러 개가 떴을 때 가른다.
  pid Int?

  /// 돌린 산출물의 판(0.0.1+a1b2c3d). **어느 빌드인지가 여기서 드러난다** —
  /// 잡 이름이나 동작이 이상하면 대개 옛 빌드가 남아 있는 것이다.
  /// 빌드하지 않고 소스로 돌리면 sha 자리가 dev 다(build-info.ts 참고).
  version String? @db.VarChar(50)

  /// "이 잡이 매일 돌았나" — 정렬까지 인덱스로 해결된다.
  /// 분류(BatchCategory)로 거를 때도 category → job 목록을 코드에서 푼 뒤
  /// `job IN (...)` 으로 오므로 이 인덱스를 그대로 탄다.
  @@index([job, startedAt])
  /// 잡을 가리지 않는 기간 조회
  @@index([startedAt])
  @@map("batch_job_history")
}

/// 단계 한 번. sync_state(메인 DB)의 과거 상태들이다.
///
/// **생략(skip)도 남긴다.** 안 남기면 "돌았는데 전부 신선해서 건너뜀" 과 "프로세스가 죽어
/// 아예 안 돎" 이 구별되지 않는다 — 목록 단계는 신선도가 7일이라 주 6일이 생략이고,
/// 그동안 sync_state 는 미동도 하지 않는다.
///
/// **행은 시작할 때 만들고 끝날 때 고친다.** 끝날 때 한 번만 넣으면 SIGKILL·OOM 으로 죽은
/// 단계가 이력에서 통째로 사라진다 — 무엇을 하다 죽었는지가 가장 알고 싶은 경우다.
/// 그런 행은 RUNNING 인 채로 남는다.
model SyncStateHistory {
  id BigInt @id @default(autoincrement())

  /// sync_state.job 과 같은 값. 예: nmc.1, hira.4.equipment
  job String @db.VarChar(50)

  /// 어느 잡 회차에 속했나. hanscli 로 단독 실행한 것이면 null.
  ///
  /// **FK 는 걸지 않는다.** 같은 로그 DB 라 걸 수는 있지만, 이 표들은 파티셔닝·보관을
  /// DBA 가 따로 관리하는 대상이고 MySQL 은 파티션 테이블에 FK 를 못 쓴다.
  batchJobHistoryId BigInt? @map("batch_job_history_id")

  /// mois | nmc | hira. job 에서 쪼갤 수 있지만 인덱스를 태우려고 따로 둔다
  provider String @db.VarChar(10)

  /// 단계 번호. 계획 문서(krdata-cache-plan.md)의 단계와 1:1 이다.
  stage Int

  /// job 의 세 번째 조각(등급·오퍼레이션). 예: 'equipment'
  detail String? @db.VarChar(30)

  /// BatchRunSource. 배치가 돌린 것과 사람이 hanscli 로 돌린 것이 여기서 갈린다.
  source Int @db.TinyInt

  /// BatchRunStatus
  status Int @db.TinyInt

  /// 생략 사유. status=SKIPPED 일 때만 찬다
  skipReason String? @map("skip_reason") @db.VarChar(100)

  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  elapsedMs  Int       @default(0) @map("elapsed_ms")

  total     Int @default(0)
  processed Int @default(0)
  calls     Int @default(0)

  error String? @db.Text

  /// "이 단계가 매일 돌았나" — 단계별 추이
  @@index([provider, stage, startedAt])
  /// 기간 전역 조회
  @@index([startedAt])
  /// "이 회차에 무슨 일이 있었나" — 부모에서 자식으로
  @@index([batchJobHistoryId])
  @@map("sync_state_history")
}
