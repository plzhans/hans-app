// LLM 사용량 모델. 멀티파일 스키마의 한 조각으로, default.prisma 의
// generator·datasource(로그 DB, DATABASE_LOG_URL)를 공유한다.
//
// 적재 목적은 둘이다: **얼마나 썼나(정산)** 와 **왜 그랬나(추적)**.
// 메인 DB 와 별도 client 라 userId·appId 는 관계 없이 값만 보관한다.

/// LLM 호출 한 건.
///
/// **질문 원문도 프롬프트 전문도 담지 않는다.** 건강 관련 질문이라 보관하면 파기 의무가
/// 따라붙는데, 정산에 필요한 것은 "몇 토큰 썼나" 이지 "무엇을 물었나" 가 아니다.
/// 대신 질문 해시를 둬서 같은 질문이 몇 번 왔는지는 셀 수 있게 했다(원문 복원은 불가).
///
/// **캐시 히트도 남긴다**(cached=true, 토큰 0). 안 남기면 수요를 알 수 없어 캐시가
/// 얼마나 값을 하는지 못 잰다 — 정산은 cached=false 만 합산하면 된다.
model LlmUsage {
  id BigInt @id @default(autoincrement())

  /// 추적 id(X-Request-Id). 같은 값으로 애플리케이션 로그와 이어 본다.
  requestId String? @map("request_id") @db.VarChar(64)

  /// 어느 클라이언트 앱에서 왔나. 로그인 전 사용량은 이 단위로 묶인다.
  appId Int? @map("app_id")

  /// 회원번호. 로그인 전이면 null — 그때는 appId 로만 센다.
  userId Int? @map("user_id")

  /// 어떤 일에 쓴 호출인가(예: hospital-search). 기능이 늘면 값이 늘어난다.
  feature String @db.VarChar(50)

  /// 기준 프롬프트 이름. 전문은 안 담는다 — 파일이 정본이다.
  promptName String @map("prompt_name") @db.VarChar(50)

  /// 그 프롬프트의 판(sha256 앞 16자). **프롬프트를 고치면 값이 갈린다** —
  /// 품질이 언제부터 달라졌는지를 이 값으로 가른다.
  promptHash String @map("prompt_hash") @db.VarChar(32)

  /// 정규화한 질문의 해시. **원문은 복원할 수 없다.** 같은 질문의 반복을 세는 데만 쓴다.
  questionHash String @map("question_hash") @db.VarChar(64)

  provider String @db.VarChar(20)

  /// 실제로 답한 모델. 별칭을 보내도 업체가 구체 버전으로 풀어 준다.
  model String @db.VarChar(100)

  inputTokens  Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")

  /// 업체 프롬프트 캐시에서 읽은 입력 토큰. 정가의 1/10 로 청구된다.
  cacheReadTokens Int @default(0) @map("cache_read_tokens")

  /// 업체 프롬프트 캐시에 쓴 입력 토큰. 정가의 1.25배로 청구된다.
  cacheWriteTokens Int @default(0) @map("cache_write_tokens")

  /// 우리 Redis 캐시에서 나온 답이면 true. **이때 토큰은 전부 0 이다**(호출이 없었다).
  cached Boolean @default(false)

  /// 서버가 이 요청을 처리한 시간(ms).
  elapsedMs Int @map("elapsed_ms")

  /// 업체가 준 요청 id(anthropic 의 `request-id`). 업체에 문의할 때 쓰는 값이다.
  upstreamId String? @map("upstream_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  /// 정산: 기간 + 대상으로 합산한다.
  @@index([createdAt, appId])
  @@index([createdAt, userId])
  /// 추적: 로그에서 본 id 로 바로 찾는다.
  @@index([requestId])
  @@map("llm_usage")
}
