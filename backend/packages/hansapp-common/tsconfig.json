{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    // 파일 하나씩 따로 컴파일해도 되는 코드로 제한한다. ts-jest 가 그렇게 돌고(nodenext 와
    // 짝이라 켜지 않으면 경고), 앱 tsconfig 도 같은 설정이다.
    "isolatedModules": true,
    // 워크스페이스 패키지를 import 할 때 exports 의 "src" 조건을 켠다 — dist 의 .d.ts 가 아니라
    // 원본 .ts 로 해석돼 편집기의 "정의로 이동" 이 소스로 간다(앱 tsconfig 와 같은 설정).
    "customConditions": ["src"]
  },
  // **spec 을 여기서 빼지 않는다.** 이 파일은 편집기와 eslint(projectService)가 보는 것이고,
  // 빼면 타입 기반 린트가 테스트를 "프로젝트에 없는 파일" 로 보고 파싱을 거부한다.
  // 빌드 산출물에서 빼는 것은 tsconfig.build.json 이 한다(hansapp-api 와 같은 방식).
  "include": ["src"]
}
