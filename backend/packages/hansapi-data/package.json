{
  "name": "@hansapi/data",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "src": "./src/seed/index.ts",
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    }
  },
  "dependencies": {
    "@hansapi/common": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2"
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --schema prisma/main/schema.prisma && prisma generate --schema prisma/log/schema.prisma",
    "prisma:migrate:dev": "dotenv -e ../../env/.env.${APP_ENV:-dev} -- prisma migrate dev --schema prisma/main/schema.prisma",
    "prisma:migrate:deploy": "dotenv -e ../../env/.env.${APP_ENV:-dev} -- prisma migrate deploy --schema prisma/main/schema.prisma",
    "prisma:migrate:status": "dotenv -e ../../env/.env.${APP_ENV:-dev} -- prisma migrate status --schema prisma/main/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.3"
  }
}
