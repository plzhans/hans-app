{
  "name": "@hansapi/data",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "src": "./src/seed/index.ts",
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    },
    "./reference": {
      "src": "./src/reference/index.ts",
      "types": "./dist/reference/index.d.ts",
      "default": "./dist/reference/index.js"
    }
  },
  "dependencies": {
    "@hansapi/common": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2"
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "postinstall": "pnpm prisma:generate",
    "codegen:subway": "node -r @swc-node/register scripts/build-subway-station.ts",
    "prisma:generate": "prisma generate --schema prisma/main/schema.prisma && prisma generate --schema prisma/log/schema.prisma",
    "schema:format": "prisma-case-format --file prisma/main/schema.prisma --table-case pascal --field-case camel",
    "schema:format:check": "prisma-case-format --file prisma/main/schema.prisma --table-case pascal --field-case camel --dry-run",
    "prisma:migrate:dev": "dotenv -e ../../config/${APP_ENV:-develop}/${APP_ENV:-develop}.env -- prisma migrate dev --schema prisma/main/schema.prisma",
    "prisma:migrate:deploy": "dotenv -e ../../config/${APP_ENV:-develop}/${APP_ENV:-develop}.env -- prisma migrate deploy --schema prisma/main/schema.prisma",
    "prisma:migrate:status": "dotenv -e ../../config/${APP_ENV:-develop}/${APP_ENV:-develop}.env -- prisma migrate status --schema prisma/main/schema.prisma"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.13.2",
    "dotenv-cli": "^10.0.0",
    "exceljs": "^4.4.0",
    "prisma": "^6.19.3",
    "prisma-case-format": "2.2.1"
  }
}
