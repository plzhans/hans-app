{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // reference/subway-station.json 을 import 한다. tsc 가 outDir 로 함께 복사한다.
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "moduleResolution": "nodenext"
  },
  "include": ["src"]
}
