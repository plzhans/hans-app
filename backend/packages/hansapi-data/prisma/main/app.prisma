// 개발자 플랫폼 도메인: 앱(App) 등록 + API 키 + OAuth 클라이언트.
// 멀티파일 스키마의 한 조각으로 default.prisma 의 generator·datasource(메인 DB)를 공유한다.
// 서드파티가 자기 서비스를 "앱"으로 등록하고, 그 아래 API 키(서버용)와 클라이언트(브라우저/OAuth)를 만든다.
//
// **이 파일만 들어내면 개발자 플랫폼 스키마를 통째로 이관**할 수 있게 도메인을 한 파일에 모은다.

/// 앱. 서드파티가 등록하는 서비스 단위. 사용자 tier 로 생성 한도가 정해진다.
model App {
  id Int @id @default(autoincrement())

  /// 앱 이름(표시용)
  name String @db.VarChar(100)

  /// 생성자 유저 id(감사 마킹, 불변). 접근 권한은 members(AppMember)로 관리한다.
  createdBy Int @map("created_by")

  /// 서비스 키(app_api_key) 발급 상한. 기본 3. 앱별로 더 필요하면 이 값만 올린다(코드 상수 아님).
  apiKeyLimit Int @default(3) @map("api_key_limit")

  /// 앱 상태. PENDING(미승인)·ACTIVE(승인)·DISABLED(삭제·차단).
  /// **인증이 직접 보는 건 앱이 아니라 키/클라이언트의 status 다.** 앱 상태는 승인 흐름과
  /// 하위 발급물의 상태를 정하는 축이다 — 승인 시 이 값이 ACTIVE 로 가며 하위 PENDING 도 함께 켜진다.
  status AppStatus @default(PENDING)

  /// 소프트 삭제 시각. non-null 이면 삭제된 앱 — 목록·접근에서 제외하고 배치가 N일 후 완전 삭제한다.
  /// (인증 거부는 status 로 판정하므로 이 값은 목록 숨김·정리 타이밍 용도다.)
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members AppMember[]
  apiKeys AppApiKey[]
  clients AppClient[]

  @@index([createdBy])
  @@map("app")
}

/// 앱 멤버(접근 권한). 지금은 생성자 1명(OWNER)만 들어간다. 초대·추가는 추후 확장.
/// owner 도 별도 컬럼이 아니라 role=OWNER 인 멤버로 표현한다(GitHub/GCP IAM 방식).
model AppMember {
  id Int @id @default(autoincrement())

  appId  Int @map("app_id")
  userId Int @map("user_id")

  /// 역할. OWNER(앱당 1명, 삭제·소유) / ADMIN(관리) / MEMBER(읽기).
  role AppRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")

  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 한 사람은 앱당 한 행.
  @@unique([appId, userId])
  @@index([userId])
  @@map("app_member")
}

enum AppRole {
  OWNER
  ADMIN
  MEMBER
}

enum AppStatus {
  /// 미승인. 발급은 되지만 인증은 거부된다(ACTIVE 만 통과). 승인 시 ACTIVE 로 전환된다.
  /// 콘솔에서 사용자가 만든 앱·키·클라이언트의 기본 상태다(CLI 는 관리자라 기본 ACTIVE).
  PENDING
  ACTIVE
  /// 꺼짐 — 사용자 off · 소프트 삭제 · 차단. **승인이 되살리지 않는다**(사용자 의도 보존).
  DISABLED
}

/// API 키. 백엔드 API 를 서버-서버로 직접 호출할 때 쓰는 시크릿.
/// 원문은 생성 시 1회만 노출하고, 서버엔 SHA-256 해시와 표시용 접두사만 저장한다.
model AppApiKey {
  id Int @id @default(autoincrement())

  appId Int @map("app_id")

  /// 키 이름(용도 구분)
  name String @db.VarChar(100)

  /// 표시용 접두사(예: sk_live_ab12…). 목록에서 어떤 키인지 식별용.
  keyPrefix String @map("key_prefix") @db.VarChar(20)

  /// SHA-256(원문) hex 64자
  keyHash String @map("key_hash") @db.Char(64)

  /// 키 상태. 앱 소프트 삭제 시 DISABLED 로 내린다(인증 거부).
  status AppStatus @default(PENDING)

  /// 마지막 사용 시각(사용량/감사용). 미사용이면 null.
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("app_api_key")
}

/// OAuth 클라이언트. 구글처럼 **플랫폼별 별도 클라이언트**(WEB/IOS/ANDROID)로 등록한다.
/// 앱당 여러 개 가능하며 type 에 따라 채워지는 필드가 갈린다.
/// - WEB    : origins(CORS 허용 원본) + redirectUris(return_to 화이트리스트) + client secret.
/// - IOS    : config = { bundleId }. secret 없음(공개 클라이언트, PKCE).
/// - ANDROID: config = { packageName, fingerprints[] }. secret 없음(공개 클라이언트, PKCE).
/// 네이티브 redirect 는 식별자에서 커스텀 스킴을 파생한다(런타임 배선 시 확정).
model AppClient {
  id Int @id @default(autoincrement())

  appId Int @map("app_id")

  /// 공개 클라이언트 식별자(예: cl_ab12…). 전역 유일.
  clientId String @unique @map("client_id") @db.VarChar(40)

  /// 클라이언트 이름(플랫폼 구분용, 예: "웹", "iOS 앱").
  name String @db.VarChar(100)

  /// 플랫폼 타입.
  type AppClientType

  /// [WEB] 자바스크립트 원본 목록(CORS 허용 대상). string[] JSON. 네이티브는 null.
  origins Json?

  /// [WEB] 로그인 복귀 허용 경로 목록(return_to 화이트리스트). string[] JSON. 네이티브는 null.
  redirectUris Json? @map("redirect_uris")

  /// [WEB] 클라이언트 보안 비밀번호. 원문(cs_...)은 발급 시 1회만 노출, 서버엔 SHA-256 해시만. 네이티브는 null.
  clientSecretHash String? @map("client_secret_hash") @db.Char(64)

  /// [WEB] 표시용 시크릿 뒤 4자(****1Yl_ 처럼 마스킹 표기용). 네이티브는 null.
  secretSuffix String? @map("secret_suffix") @db.VarChar(8)

  /// [WEB] 시크릿 발급/재발급 시각. 네이티브는 null.
  secretCreatedAt DateTime? @map("secret_created_at")

  /// [NATIVE] 플랫폼 식별자. iOS={ bundleId }, Android={ packageName, fingerprints:[] }. 웹은 null.
  config Json?

  /// 클라이언트 상태. 앱 소프트 삭제 시 DISABLED 로 내린다(인증 거부).
  status AppStatus @default(PENDING)

  /// 마지막 사용 시각(OAuth 사용 시 갱신). 미사용이면 null.
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("app_client")
}

enum AppClientType {
  WEB
  IOS
  ANDROID
}
