      // sido_cd_nm / sggu_cd_nm / emdong_nm / addr
      "ko": { "sido": "", "sigungu": "", "dong": "", "detail": "" },
      "en": { "sido": "", "sigungu": "", "dong": "", "detail": "" }, //
      "ja": { "sido": "", "sigungu": "", "dong": "", "detail": "" } //
    },
    "zipcode": "", // post_no (우편번호)
    "lat": 0, // y_pos (위도) — varchar → number 파싱
    "lon": 0, // x_pos (경도) — varchar → number 파싱

    // 랜드마크(공공건물 기준 위치) — detail
    "landmark": {
