    "orgTyCdNm": { "ko": "" } // org_ty_cd_nm (설립구분명)
  },

  "name": {
    "ko": "" // yadm_nm (병원명)
  },

  "categoryId": 0, // cl_cd (종별코드)
  "categoryName": { "ko": "" }, // cl_cd_nm (종별코드명)

  "establishment": {
    "date": "" // estb_dd (개설일자 yyyyMMdd)
  },

  "link": {
    "homepage": "" // hosp_url (병원 URL)
  },

  // 진료과목 — 코드 → { name, 인력 } 맵. diagnosis_subject + specialty 병합
  "specialties": {
    "01": {
      "name": { "ko": "내과" }, // dgsbjt_cd_nm
      "doctorCount": null, // dgsbjt_pr_sdr_cnt (의사수)
