{
  "openapi": "3.0.3",
  "info": {
    "title": "건강보험심사평가원(HIRA) 의약품성분약효정보조회서비스",
    "version": "1.0.0",
    "description": "의약품 주성분코드(일반명코드)·약효분류번호 기준으로 약효분류명·제형구분명·일반명·투여경로명·함량내용·단위를 조회한다. 전건 60,424건(2026-07 실측).\n\n키가 되는 `gnlNmCd`(일반명코드)는 이 서비스가 발급하는 게 아니다. **약가기준정보조회서비스의 약가목록조회 응답**이나 심평원 홈페이지의 약제급여목록표에서 얻어 온다.\n\n필드명·타입은 가이드가 아니라 실응답을 따랐다(2026-07 실측) — **가이드의 제형구분명·투여경로명 필드명이 둘 다 틀렸다.** 아래 필드 설명 참고.\n\n**검색 파라미터를 하나도 안 주면 `totalCount: 0` 이다**(2026-07 실측). 필터가 사실상 필수인 검색형 API다. 전량을 받으려면 `gnlNmCd=%` 처럼 **와일드카드 `%`** 를 준다.",
    "x-measured": "2026-07 실측. 표본 7,000행(페이지 1·10·20·…·60 에서 1,000행씩 흩어 수집)."
  },
  "servers": [
    {
      "url": "https://apis.data.go.kr/B551182"
    }
  ],
  "paths": {
    "/msupCmpnMeftInfoService/getMajorCmpnNmCdList": {
      "get": {
        "operationId": "getMajorComponentCodeList",
        "summary": "주성분명칭코드목록조회",
        "description": "일반명코드·약효분류번호 등으로 함량내용·투여경로·제형구분·분류명을 조회한다. 파라미터를 다 비우면 0건이니 전량 조회는 `gnlNmCd=%` 로 한다 — 60,424건이라 numOfRows=1000 이면 61콜이다.",
        "tags": ["msup-cmpn"],
        "parameters": [
          { "$ref": "#/components/parameters/PageNo" },
          { "$ref": "#/components/parameters/NumOfRows" },
          { "$ref": "#/components/parameters/GnlNmCd" },
          { "$ref": "#/components/parameters/GnlNm" },
          { "$ref": "#/components/parameters/MeftDivNo" },
          { "$ref": "#/components/parameters/DivNm" }
        ],
        "responses": {
          "200": {
            "description": "주성분명칭코드 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MajorComponentCodeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PageNo": {
        "name": "pageNo",
        "in": "query",
        "required": false,
        "description": "페이지 번호",
        "schema": { "type": "integer", "default": 1 }
      },
      "NumOfRows": {
        "name": "numOfRows",
        "in": "query",
        "required": false,
        "description": "한 페이지 결과 수. 생략하면 10. 1000 까지 정상 동작한다(2026-07 실측).",
        "schema": { "type": "integer", "default": 10 }
      },
      "GnlNmCd": {
        "name": "gnlNmCd",
        "in": "query",
        "required": false,
        "description": "일반명코드(주성분코드). 예: 100101AGN. 앞부분 일치라 `1` 만 줘도 5,264건이 걸린다. `%` 만 주면 전건이다(2026-07 실측).",
        "schema": { "type": "string" }
      },
      "GnlNm": {
        "name": "gnlNm",
        "in": "query",
        "required": false,
        "description": "일반명 (일반명코드에 대한 명칭). 예: 상황균사체엑스",
        "schema": { "type": "string" }
      },
      "MeftDivNo": {
        "name": "meftDivNo",
        "in": "query",
        "required": false,
        "description": "약효분류번호. 예: 421",
        "schema": { "type": "string" }
      },
      "DivNm": {
        "name": "divNm",
        "in": "query",
        "required": false,
        "description": "분류명 (약효분류번호에 해당하는 명칭). 예: 항악성종양제",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "ResultHeader": {
        "type": "object",
        "description": "공통 응답 헤더",
        "properties": {
          "resultCode": {
            "type": "string",
            "description": "결과코드 (정상: 00)"
          },
          "resultMsg": { "type": "string", "description": "결과메시지" }
        }
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "numOfRows": {
            "type": "integer",
            "description": "한 페이지 결과 수"
          },
          "pageNo": { "type": "integer", "description": "현재 페이지 번호" },
          "totalCount": {
            "type": "integer",
            "description": "전체 결과 수. 검색 파라미터를 하나도 안 주면 0 이다."
          }
        }
      },
      "MajorComponentCodeResponse": {
        "type": "object",
        "properties": {
          "response": {
            "$ref": "#/components/schemas/MajorComponentCodeResult"
          }
        }
      },
      "MajorComponentCodeResult": {
        "type": "object",
        "properties": {
          "header": { "$ref": "#/components/schemas/ResultHeader" },
          "body": { "$ref": "#/components/schemas/MajorComponentCodeBody" }
        }
      },
      "MajorComponentCodeBody": {
        "allOf": [
          { "$ref": "#/components/schemas/PageInfo" },
          {
            "type": "object",
            "properties": {
              "items": {
                "$ref": "#/components/schemas/MajorComponentCodeItems"
              }
            }
          }
        ]
      },
      "MajorComponentCodeItems": {
        "type": "object",
        "properties": {
          "item": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MajorComponentCodeItem"
            }
          }
        }
      },
      "MajorComponentCodeItem": {
        "type": "object",
        "description": "주성분(일반명) 한 건. `gnlNmCd` 는 성분·함량·제형·투여경로를 한 코드에 담고 있어(예: 100101AGN) 같은 성분이라도 함량이 다르면 다른 코드다 — `gnlNm` 은 여러 행에 중복된다.\n\n필드명은 실응답 기준이다(2026-07 실측, 표본 7,000행).",
        "properties": {
          "gnlNmCd": {
            "type": "string",
            "description": "일반명코드(주성분코드). 예: 100101AGN. 표본 전건이 문자열이었다(끝 3자리가 영문이라 숫자로 뭉개지지 않는다). 약가기준정보조회서비스의 약가목록조회에서 얻는다."
          },
          "gnlNm": {
            "type": "string",
            "description": "일반명 (일반명코드에 대한 명칭)"
          },
          "meftDivNo": {
            "type": "integer",
            "description": "약효분류번호. **문자열이 아니라 JSON number 로 온다**(2026-07 실측). 표본에서 98종이 나왔고 범위는 112~821 이라 앞자리 0 은 없다.",
            "example": 421
          },
          "divNm": {
            "type": "string",
            "description": "분류명 (약효분류번호에 해당하는 명칭). 예: 항악성종양제"
          },
          "fomnTpCdNm": {
            "type": "string",
            "description": "제형구분명. 예: '과립제,세립'. **가이드 표기는 `fomnTpNm` 이지만 실제 필드명은 이것이다**(2026-07 실측). 여러 제형이 쉼표로 붙어 오니 단일 값으로 보지 마라. **없는 행이 있다**(표본 7,000행 중 8건)."
          },
          "injcPthCdNm": {
            "type": "string",
            "description": "투여경로명 (내복/주사/외용 등). **가이드 표기는 `injcPthNm` 이지만 실제 필드명은 이것이다**(2026-07 실측)."
          },
          "iqtyTxt": {
            "oneOf": [{ "type": "number" }, { "type": "string" }],
            "description": "함량내용. **숫자와 문자열이 섞여 온다**(2026-07 실측). 대부분 JSON number(`1.1`·`250`)지만 `'25×50'`(치수), `'11.50'`, `' 1'`(앞 공백) 같은 문자열도 있다 — 이름대로 '텍스트'라서 **숫자로 단정하고 파싱하면 터진다.** 단위는 `unit` 에 따로 있다.",
            "example": 1.1
          },
          "unit": {
            "type": "string",
            "description": "단위 (예: g, mg, mm, '단위(IR 또는 IC)'). **없는 행이 있다**(표본 7,000행 중 1건)."
          }
        }
      }
    }
  }
}
