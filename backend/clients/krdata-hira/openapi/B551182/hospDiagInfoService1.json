{
  "openapi": "3.0.3",
  "info": {
    "title": "건강보험심사평가원(HIRA) 병원별질병정보서비스",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apis.data.go.kr/B551182"
    }
  ],
  "paths": {
    "/hospDiagInfoService1/getClinicTop5List1": {
      "get": {
        "operationId": "getClinicTop5List",
        "summary": "의원 진료 상위질병 5개 목록 조회",
        "description": "암호화된 요양기호(ykiho)로 최근 1년간 해당 의원에서 진료된 상위 5개 국민관심질병명을 오름차순으로 조회한다. 단일 조회이므로 numOfRows·pageNo 는 1 고정. ykiho 는 병원기본목록(getHospBasisList)에서 clCd='31'(의원)로 조회해 얻는다.",
        "tags": ["hosp-diag"],
        "parameters": [
          {
            "$ref": "#/components/parameters/Ykiho"
          },
          {
            "$ref": "#/components/parameters/PageNo"
          },
          {
            "$ref": "#/components/parameters/NumOfRows"
          }
        ],
        "responses": {
          "200": {
            "description": "의원 진료 상위질병 5개 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicTop5Response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Ykiho": {
        "name": "ykiho",
        "in": "query",
        "required": true,
        "description": "암호화된 요양기호",
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      },
      "PageNo": {
        "name": "pageNo",
        "in": "query",
        "required": false,
        "description": "페이지 번호 (단일 조회이므로 1 고정)",
        "schema": {
          "type": "integer",
          "default": 1
        }
      },
      "NumOfRows": {
        "name": "numOfRows",
        "in": "query",
        "required": false,
        "description": "한 페이지 결과 수 (단일 조회이므로 1 고정)",
        "schema": {
          "type": "integer",
          "default": 1
        }
      }
    },
    "schemas": {
      "ResultHeader": {
        "type": "object",
        "description": "공통 응답 헤더",
        "properties": {
          "resultCode": {
            "type": "string",
            "description": "결과코드 (정상: 00)"
          },
          "resultMsg": {
            "type": "string",
            "description": "결과메시지"
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "numOfRows": {
            "type": "integer",
            "description": "한 페이지 결과 수"
          },
          "pageNo": {
            "type": "integer",
            "description": "현재 페이지 번호"
          },
          "totalCount": {
            "type": "integer",
            "description": "전체 결과 수"
          }
        }
      },
      "ClinicTop5Response": {
        "type": "object",
        "properties": {
          "response": {
            "$ref": "#/components/schemas/ClinicTop5Result"
          }
        }
      },
      "ClinicTop5Result": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "body": {
            "$ref": "#/components/schemas/ClinicTop5Body"
          }
        }
      },
      "ClinicTop5Body": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PageInfo"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "$ref": "#/components/schemas/ClinicTop5Items"
              }
            }
          }
        ]
      },
      "ClinicTop5Items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClinicTop5Item"
            }
          }
        }
      },
      "ClinicTop5Item": {
        "type": "object",
        "description": "의원 진료 상위질병 5개 항목. 필드명은 가이드가 아니라 실응답을 따랐다(2026-07 실측).",
        "properties": {
          "rnum": {
            "type": "integer",
            "description": "행 번호. 가이드 응답 표에 없지만 실제로는 온다."
          },
          "crtrYm": {
            "type": "integer",
            "description": "기준년월 (예: 202601). 이 시점 기준 최근 1년 자료. 가이드는 문자열이라 하지만 실제로는 숫자로 온다."
          },
          "mfrnIntrsIlnsCdNm1": {
            "type": "string",
            "description": "국민관심질병명1 (진료량 상위, 오름차순). 가이드 표기는 mfrnIntrsIlnsNm1 이지만 실제 필드명은 이것이다."
          },
          "mfrnIntrsIlnsCdNm2": {
            "type": "string",
            "description": "국민관심질병명2 (진료량 상위, 오름차순)"
          },
          "mfrnIntrsIlnsCdNm3": {
            "type": "string",
            "description": "국민관심질병명3 (진료량 상위, 오름차순)"
          },
          "mfrnIntrsIlnsCdNm4": {
            "type": "string",
            "description": "국민관심질병명4 (진료량 상위, 오름차순)"
          },
          "mfrnIntrsIlnsCdNm5": {
            "type": "string",
            "description": "국민관심질병명5 (진료량 상위, 오름차순)"
          },
          "shwSbjtCdNm": {
            "type": "string",
            "description": "표시과목명 (의원의 진료과목명). 가이드 표기는 shwSbjtNm 이지만 실제 필드명은 이것이다."
          },
          "yadmNm": {
            "type": "string",
            "description": "요양기관명"
          },
          "ykiho": {
            "type": "string",
            "description": "암호화된 요양기호"
          }
        }
      }
    }
  }
}
