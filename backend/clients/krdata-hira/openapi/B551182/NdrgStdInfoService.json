{
  "openapi": "3.0.3",
  "info": {
    "title": "건강보험심사평가원(HIRA) 신포괄기준정보서비스",
    "version": "1.0.0",
    "description": "신포괄수가제(New DRG, 묶음지불)에서 개별 분류코드(행위·약제·치료재료)가 **어떻게 취급되는지**(포괄/비포괄/전액본인부담…)를 매핑한 목록.\n\n**코드 자체의 마스터가 아니다** — `divCd` 는 다른 서비스가 소유한 코드다(divTyCd 로 어느 체계인지 갈린다: 1=수가(mdfeeCd), 3=약가, 8=치료재료(mcatCd)). 이 서비스는 그 코드에 '신포괄에서의 포괄구분' 을 붙일 뿐이다.\n\n**비급여 진료비(npayCd)와 무관하다.** 신포괄은 지불제도 구분이고, `ndrgItmIcsnTpCd=3(전액본인부담)·4(전액비포괄)` 가 있지만 이는 신포괄 병원 안에서의 청구 구분이지 비급여 항목 코드가 아니다.\n\n적재·연동은 없다. 스펙·클라이언트만 만들어 둔 상태다(2026-07).",
    "x-measured": "2026-07 실측. adtStaDd=20160101 전건 totalCount 52,319. 응답 필드가 가이드(5개)와 다르다 — 실제 10개."
  },
  "servers": [{ "url": "https://apis.data.go.kr/B551182" }],
  "paths": {
    "/NdrgStdInfoService/getNdrgPayList": {
      "get": {
        "operationId": "getNewDrgPaymentList",
        "summary": "신포괄급여목록조회",
        "description": "분류코드(행위·약제·치료재료)의 신포괄 포괄구분·본인부담율 인정여부를 조회한다.\n\n**adtStaDd(적용시작일자)가 필수다.** 20160101 로 주면 전건 52,319건이 나온다(2026-07 실측). divTyCd/divCd/ndrgItmIcsnTpCd 로 좁힐 수 있다.\n\n**가이드 응답 필드는 5개라지만 실제 10개다**(2026-07 실측) — 자기부담율 인정여부 4개(slfBrdnRtCz*)와 신포괄선별급여인정여부(ndrgSelPayAdtYn)가 가이드에 빠져 있다.",
        "tags": ["ndrg"],
        "parameters": [
          { "$ref": "#/components/parameters/PageNo" },
          { "$ref": "#/components/parameters/NumOfRows" },
          { "$ref": "#/components/parameters/AdtStaDd" },
          { "$ref": "#/components/parameters/DivTyCd" },
          { "$ref": "#/components/parameters/DivCd" },
          { "$ref": "#/components/parameters/NdrgItmIcsnTpCd" }
        ],
        "responses": {
          "200": {
            "description": "신포괄급여 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewDrgPaymentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PageNo": {
        "name": "pageNo",
        "in": "query",
        "required": false,
        "description": "페이지 번호",
        "schema": { "type": "integer", "default": 1 }
      },
      "NumOfRows": {
        "name": "numOfRows",
        "in": "query",
        "required": false,
        "description": "한 페이지 결과 수. 생략하면 10.",
        "schema": { "type": "integer", "default": 10 }
      },
      "AdtStaDd": {
        "name": "adtStaDd",
        "in": "query",
        "required": true,
        "description": "적용시작일자 (YYYYMMDD). **필수다.** 20160101 로 주면 전건이 나온다.",
        "schema": { "type": "string", "example": "20160101" }
      },
      "DivTyCd": {
        "name": "divTyCd",
        "in": "query",
        "required": false,
        "description": "분류유형코드. 어느 코드 체계인지 가른다 — 1=수가코드(mdfeeCd), 3=국산보험등재약, 8=치료재료대(mcatCd).",
        "schema": { "type": "string", "enum": ["1", "3", "8"] }
      },
      "DivCd": {
        "name": "divCd",
        "in": "query",
        "required": false,
        "description": "분류코드 (예: H3018032). 부분일치(%A%). 이 코드의 소유·의미는 divTyCd 가 가리키는 다른 서비스에 있다.",
        "schema": { "type": "string" }
      },
      "NdrgItmIcsnTpCd": {
        "name": "ndrgItmIcsnTpCd",
        "in": "query",
        "required": false,
        "description": "신포괄품목 포괄구분코드. 1=비포괄, 2=포괄, 3=전액본인부담, 4=전액비포괄, 5=행위별분리청구.",
        "schema": { "type": "string", "enum": ["1", "2", "3", "4", "5"] }
      }
    },
    "schemas": {
      "ResultHeader": {
        "type": "object",
        "description": "공통 응답 헤더",
        "properties": {
          "resultCode": {
            "type": "string",
            "description": "결과코드 (정상: 00)"
          },
          "resultMsg": { "type": "string", "description": "결과메시지" }
        }
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "numOfRows": {
            "type": "integer",
            "description": "한 페이지 결과 수"
          },
          "pageNo": { "type": "integer", "description": "현재 페이지 번호" },
          "totalCount": { "type": "integer", "description": "전체 결과 수" }
        }
      },
      "NewDrgPaymentResponse": {
        "type": "object",
        "properties": {
          "response": { "$ref": "#/components/schemas/NewDrgPaymentResult" }
        }
      },
      "NewDrgPaymentResult": {
        "type": "object",
        "properties": {
          "header": { "$ref": "#/components/schemas/ResultHeader" },
          "body": { "$ref": "#/components/schemas/NewDrgPaymentBody" }
        }
      },
      "NewDrgPaymentBody": {
        "allOf": [
          { "$ref": "#/components/schemas/PageInfo" },
          {
            "type": "object",
            "properties": {
              "items": { "$ref": "#/components/schemas/NewDrgPaymentItems" }
            }
          }
        ]
      },
      "NewDrgPaymentItems": {
        "type": "object",
        "description": "**0건이면 items 가 빈 문자열('')로 온다** — mutator 가 배열로 정규화한다.",
        "properties": {
          "item": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NewDrgPaymentItem" }
          }
        }
      },
      "NewDrgPaymentItem": {
        "type": "object",
        "description": "분류코드 하나의 신포괄 취급. **코드의 이름·가격은 없다** — 이 서비스는 포괄구분만 준다.",
        "properties": {
          "divCd": {
            "type": "string",
            "description": "분류코드 (예: H3018032). 소유 체계는 divTyCd 참조.",
            "example": "H3018032"
          },
          "divTyCd": {
            "type": "integer",
            "description": "분류유형코드. **가이드는 string 이라지만 JSON number 로 온다**(2026-07 실측). 1=수가/3=약가/8=치료재료.",
            "example": 8
          },
          "ndrgItmIcsnTpCd": {
            "type": "integer",
            "description": "신포괄품목 포괄구분코드. **JSON number 로 온다**(2026-07 실측). 1=비포괄/2=포괄/3=전액본인부담/4=전액비포괄/5=행위별분리청구.",
            "example": 1
          },
          "adtStaDd": {
            "type": "integer",
            "description": "적용시작일자 (YYYYMMDD). **JSON number 로 온다**(2026-07 실측).",
            "example": 20160101
          },
          "adtEndDd": {
            "type": "integer",
            "description": "적용종료일자 (YYYYMMDD). JSON number. 종료가 없으면 99991231.",
            "example": 20191231
          },
          "ndrgSelPayAdtYn": {
            "type": "string",
            "description": "신포괄선별급여인정여부 (Y/N). **가이드에 없는 필드다**(2026-07 실측).",
            "example": "N"
          },
          "slfBrdnRtCzaApvYn": {
            "type": "string",
            "description": "본인부담율 A항 인정여부 (Y/N). **가이드에 없는 필드다**(2026-07 실측).",
            "example": "N"
          },
          "slfBrdnRtCzbApvYn": {
            "type": "string",
            "description": "본인부담율 B항 인정여부 (Y/N). 가이드에 없는 필드다.",
            "example": "N"
          },
          "slfBrdnRtCzdApvYn": {
            "type": "string",
            "description": "본인부담율 D항 인정여부 (Y/N). 가이드에 없는 필드다.",
            "example": "N"
          },
          "slfBrdnRtCzeApvYn": {
            "type": "string",
            "description": "본인부담율 E항 인정여부 (Y/N). 가이드에 없는 필드다.",
            "example": "N"
          }
        }
      }
    }
  }
}
