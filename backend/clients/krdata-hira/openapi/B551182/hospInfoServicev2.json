{
  "openapi": "3.0.3",
  "info": {
    "title": "건강보험심사평가원(HIRA) 병원정보서비스 - 병원기본목록",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apis.data.go.kr/B551182"
    }
  ],
  "paths": {
    "/hospInfoServicev2/getHospBasisList": {
      "get": {
        "operationId": "getHospitalList",
        "summary": "병원 기본목록",
        "description": "병원 기본정보 목록. 전체 79,739건 (2026-07).\n좌표(xPos/yPos)와 radius 를 주면 반경 검색이 되고 응답에 distance 가 붙는다.",
        "tags": ["hospital"],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageNo"
          },
          {
            "$ref": "#/components/parameters/NumOfRows"
          },
          {
            "$ref": "#/components/parameters/SidoCd"
          },
          {
            "$ref": "#/components/parameters/SgguCd"
          },
          {
            "$ref": "#/components/parameters/EmdongNm"
          },
          {
            "$ref": "#/components/parameters/YadmNm"
          },
          {
            "$ref": "#/components/parameters/ZipCd"
          },
          {
            "$ref": "#/components/parameters/ClCd"
          },
          {
            "$ref": "#/components/parameters/DgsbjtCd"
          },
          {
            "$ref": "#/components/parameters/XPos"
          },
          {
            "$ref": "#/components/parameters/YPos"
          },
          {
            "$ref": "#/components/parameters/Radius"
          }
        ],
        "responses": {
          "200": {
            "description": "병원 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitalListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PageNo": {
        "name": "pageNo",
        "in": "query",
        "required": false,
        "description": "페이지 번호",
        "schema": {
          "type": "integer",
          "default": 1
        }
      },
      "NumOfRows": {
        "name": "numOfRows",
        "in": "query",
        "required": false,
        "description": "한 페이지 결과 수",
        "schema": {
          "type": "integer",
          "default": 10
        }
      },
      "SidoCd": {
        "name": "sidoCd",
        "in": "query",
        "required": false,
        "description": "시도코드 (예: 110000=서울). getAddressCodeList 참조",
        "schema": {
          "type": "string"
        }
      },
      "SgguCd": {
        "name": "sgguCd",
        "in": "query",
        "required": false,
        "description": "시군구코드 (예: 110019=중랑구)",
        "schema": {
          "type": "string"
        }
      },
      "EmdongNm": {
        "name": "emdongNm",
        "in": "query",
        "required": false,
        "description": "읍면동명 (예: 신내동)",
        "schema": {
          "type": "string"
        }
      },
      "YadmNm": {
        "name": "yadmNm",
        "in": "query",
        "required": false,
        "description": "병원명 (예: 서울의료원)",
        "schema": {
          "type": "string"
        }
      },
      "ZipCd": {
        "name": "zipCd",
        "in": "query",
        "required": false,
        "description": "분류코드.\n2010:종합병원, 2030:병원, 2040:요양병원, 2050:치과, 2060:한방, 2070:의원,\n2080:보건기관, 2090:조산원",
        "schema": {
          "type": "string"
        }
      },
      "ClCd": {
        "name": "clCd",
        "in": "query",
        "required": false,
        "description": "종별코드. getInstitutionClassCodeList 참조.\n01:상급종합병원, 11:종합병원, 21:병원, 28:요양병원, 29:정신병원, 31:의원,\n41:치과병원, 51:치과의원, 61:조산원, 71:보건소, 72:보건지소, 73:보건진료소,\n75:보건의료원, 92:한방병원, 93:한의원",
        "schema": {
          "type": "string"
        }
      },
      "DgsbjtCd": {
        "name": "dgsbjtCd",
        "in": "query",
        "required": false,
        "description": "진료과목코드. getSubjectCodeList 참조.\n00:일반의, 01:내과, 02:신경과, 03:정신건강의학과, 04:외과, 05:정형외과,\n06:신경외과, 07:흉부외과, 08:성형외과, 09:마취통증의학과, 10:산부인과,\n11:소아청소년과, 12:안과, 13:이비인후과, 14:피부과, 15:비뇨의학과,\n16:영상의학과, 17:방사선종양학과, 18:병리과, 19:진단검사의학과, 20:결핵과,\n21:재활의학과, 22:핵의학과, 23:가정의학과, 24:응급의학과, 25:직업환경의학과,\n26:예방의학과, 50:구강악안면외과, 51:치과보철과, 52:치과교정과, 53:소아치과,\n54:치주과, 55:치과보존과, 56:구강내과, 57:영상치의학과, 58:구강병리과,\n59:예방치과, 61:통합치의학과, 80:한방내과, 81:한방부인과, 82:한방소아과,\n83:한방안이비인후피부과, 84:한방신경정신과, 85:침구과, 86:한방재활의학과,\n87:사상체질과, 88:한방응급\n\n주의: NMC 의 진료과목 코드(D001, D002 …)와 완전히 다른 체계다. 섞어 쓰면 안 된다.",
        "schema": {
          "type": "string"
        }
      },
      "XPos": {
        "name": "xPos",
        "in": "query",
        "required": false,
        "description": "x좌표 (경도). radius 와 함께 써야 반경 검색이 된다.",
        "schema": {
          "type": "string"
        }
      },
      "YPos": {
        "name": "yPos",
        "in": "query",
        "required": false,
        "description": "y좌표 (위도)",
        "schema": {
          "type": "string"
        }
      },
      "Radius": {
        "name": "radius",
        "in": "query",
        "required": false,
        "description": "반경. 단위는 미터(m). 예: 3000",
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {
      "ResultHeader": {
        "type": "object",
        "description": "공통 응답 헤더",
        "properties": {
          "resultCode": {
            "type": "string",
            "description": "결과코드 (정상: 00)"
          },
          "resultMsg": {
            "type": "string",
            "description": "결과메시지"
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "numOfRows": {
            "type": "integer",
            "description": "한 페이지 결과 수"
          },
          "pageNo": {
            "type": "integer",
            "description": "현재 페이지 번호"
          },
          "totalCount": {
            "type": "integer",
            "description": "전체 결과 수"
          }
        }
      },
      "HospitalListResponse": {
        "type": "object",
        "properties": {
          "response": {
            "$ref": "#/components/schemas/HospitalListResult"
          }
        }
      },
      "HospitalItem": {
        "type": "object",
        "description": "병원 기본정보 항목",
        "properties": {
          "ykiho": {
            "type": "string",
            "description": "암호화된 요양기호. 상세정보 조회(MadmDtlInfoService2.8)의 키다."
          },
          "yadmNm": {
            "type": "string",
            "description": "병원명"
          },
          "clCd": {
            "type": "string",
            "description": "종별코드"
          },
          "clCdNm": {
            "type": "string",
            "description": "종별코드명 (예: 상급종합)"
          },
          "sidoCd": {
            "type": "string",
            "description": "시도코드"
          },
          "sidoCdNm": {
            "type": "string",
            "description": "시도명"
          },
          "sgguCd": {
            "type": "string",
            "description": "시군구코드"
          },
          "sgguCdNm": {
            "type": "string",
            "description": "시군구명"
          },
          "emdongNm": {
            "type": "string",
            "description": "읍면동명"
          },
          "postNo": {
            "type": "string",
            "description": "우편번호"
          },
          "addr": {
            "type": "string",
            "description": "주소"
          },
          "telno": {
            "type": "string",
            "description": "전화번호"
          },
          "hospUrl": {
            "type": "string",
            "description": "홈페이지"
          },
          "estbDd": {
            "type": "string",
            "description": "개설일자 (YYYYMMDD)"
          },
          "drTotCnt": {
            "type": "integer",
            "description": "의사총수"
          },
          "mdeptGdrCnt": {
            "type": "integer",
            "description": "의과일반의 인원수"
          },
          "mdeptIntnCnt": {
            "type": "integer",
            "description": "의과인턴 인원수"
          },
          "mdeptResdntCnt": {
            "type": "integer",
            "description": "의과레지던트 인원수"
          },
          "mdeptSdrCnt": {
            "type": "integer",
            "description": "의과전문의 인원수"
          },
          "detyGdrCnt": {
            "type": "integer",
            "description": "치과일반의 인원수"
          },
          "detyIntnCnt": {
            "type": "integer",
            "description": "치과인턴 인원수"
          },
          "detyResdntCnt": {
            "type": "integer",
            "description": "치과레지던트 인원수"
          },
          "detySdrCnt": {
            "type": "integer",
            "description": "치과전문의 인원수"
          },
          "cmdcGdrCnt": {
            "type": "integer",
            "description": "한방일반의 인원수"
          },
          "cmdcIntnCnt": {
            "type": "integer",
            "description": "한방인턴 인원수"
          },
          "cmdcResdntCnt": {
            "type": "integer",
            "description": "한방레지던트 인원수"
          },
          "cmdcSdrCnt": {
            "type": "integer",
            "description": "한방전문의 인원수"
          },
          "pnursCnt": {
            "type": "integer",
            "description": "공식 가이드(2021)에 없는 필드. 값이 대부분 0 이고 드물게 한 자릿수인 것으로 보아\n전문간호사 수로 추정된다. (2026-07 확인)"
          },
          "XPos": {
            "type": "string",
            "description": "x좌표 (경도). 대문자 X 로 시작한다."
          },
          "YPos": {
            "type": "string",
            "description": "y좌표 (위도). 대문자 Y 로 시작한다."
          },
          "distance": {
            "type": "string",
            "description": "거리(m). xPos/yPos/radius 로 반경 검색했을 때만 온다."
          }
        }
      },
      "HospitalListItems": {
        "type": "object",
        "properties": {
          "item": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HospitalItem"
            }
          }
        }
      },
      "HospitalListBody": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PageInfo"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "$ref": "#/components/schemas/HospitalListItems"
              }
            }
          }
        ]
      },
      "HospitalListResult": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "body": {
            "$ref": "#/components/schemas/HospitalListBody"
          }
        }
      }
    }
  }
}
