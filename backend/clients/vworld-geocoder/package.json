{
  "name": "@vworld/geocoder",
  "version": "0.0.1",
  "private": true,
  "description": "국토교통부 공간정보 오픈플랫폼(브이월드) 지오코딩 API 클라이언트",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./openapi/*": "./openapi/*"
  },
  "scripts": {
    "codegen": "orval --config orval.config.ts",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "orval": "^7.13.2"
  }
}
