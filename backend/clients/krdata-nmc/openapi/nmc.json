  "components": {
    "parameters": {
      "PageNo": {
        "name": "pageNo",
        "in": "query",
        "required": false,
        "description": "페이지 번호",
        "schema": {
          "type": "integer",
          "default": 1
        }
      },
      "NumOfRows": {
        "name": "numOfRows",
        "in": "query",
        "required": false,
        "description": "한 페이지 결과 수. 상한이 없다. 값이 전체 건수보다 크면 전체를 한 응답에 담아 준다.\n(가이드에는 최대 메시지 사이즈 4000 bytes 로 적혀 있으나 실제로는 지켜지지 않는다.)\nFullDown 실측 (2026-07, 전체 78,631건):\n  100 → 1.1초 / 0.1MB\n  1,000 → 1.2초 / 1.1MB\n  10,000 → 3.2초 / 10.9MB\n  100,000 → 21.8초 / 84MB (전체 반환)\n콜수 제한이 있으므로 배치는 크게 받는 편이 유리하다. 다만 전체를 한 번에 받으면\n84MB 를 통째로 JSON.parse 해야 하므로 10,000 건 단위가 균형점이다.",
        "schema": {
          "type": "integer",
          "default": 10
        }
      },
      "Q0": {
        "name": "Q0",
        "in": "query",
        "required": false,
        "description": "주소(시도). 예: 서울특별시",
        "schema": {
          "type": "string",
          "maxLength": 16
        }
      },
      "Q1": {
        "name": "Q1",
        "in": "query",
        "required": false,
        "description": "주소(시군구). 예: 강남구",
        "schema": {
          "type": "string",
          "maxLength": 60
        }
      },
      "QZ": {
        "name": "QZ",
        "in": "query",
        "required": false,
        "description": "기관구분. 코드마스터 'H000' 참조. dutyDiv 와 같은 코드 체계다. (예: B=병원, C=의원)",
        "schema": {
          "type": "string",
          "maxLength": 1
        }
      },
      "QD": {
        "name": "QD",
        "in": "query",
        "required": false,
        "description": "진료과목. 코드마스터 'D000' 참조 (D001~D034).\nD001:내과, D002:소아청소년과, D003:신경과, D004:정신건강의학과, D005:피부과,\nD006:외과, D007:흉부외과, D008:정형외과, D009:신경외과, D010:성형외과,\nD011:산부인과, D012:안과, D013:이비인후과, D014:비뇨기과, D016:재활의학과,\nD017:마취통증의학과, D018:영상의학과, D019:치료방사선과, D020:임상병리과,\nD021:해부병리과, D022:가정의학과, D023:핵의학과, D024:응급의학과, D026:치과,\nD034:구강악안면외과",
        "schema": {
          "type": "string",
          "maxLength": 4
        }
      },
      "QT": {
        "name": "QT",
        "in": "query",
        "required": false,
        "description": "진료요일. 월~일요일(1~7), 공휴일(8)",
        "schema": {
          "type": "string",
          "maxLength": 1
        }
      },
      "QN": {
        "name": "QN",
        "in": "query",
        "required": false,
        "description": "기관명. 예: 삼성병원",
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      },
      "ORD": {
        "name": "ORD",
        "in": "query",
        "required": false,
        "description": "정렬 순서. 예: NAME, ADDR",
        "schema": {
          "type": "string",
          "maxLength": 20
        }
      },
      "Wgs84Lon": {
        "name": "WGS84_LON",
        "in": "query",
        "required": true,
        "description": "병원경도. 예: 127.0851566",
        "schema": {
          "type": "string"
        }
      },
      "Wgs84Lat": {
        "name": "WGS84_LAT",
        "in": "query",
        "required": true,
        "description": "병원위도. 예: 37.4881325",
        "schema": {
          "type": "string"
        }
      },
      "Hpid": {
        "name": "HPID",
        "in": "query",
        "required": true,
        "description": "기관ID. 예: A1100001",
        "schema": {
          "type": "string",
          "maxLength": 10
        }
      },
      "CmMid": {
        "name": "CM_MID",
        "in": "query",
        "required": false,
        "description": "대분류코드 필터 (예: H010).\n\n주의: 요청 파라미터명은 대문자 CM_MID 다. 응답 필드명(cmMid)과 표기가 다르다.\n소문자 cmMid 로 보내면 서버가 조용히 무시하고 전체 코드를 반환한다. (에러도 나지 않는다)\n가이드상 필수(1) 이지만 생략해도 동작하며, 이 경우 전체 코드가 내려온다.\n\n대분류코드 목록:\n  H000[기관구분]  H010[설립구분]  H020[의료기관구분]  H030[응급의료기관구분]\n  H040[운영상태]  H050[전문의구분]\n  D000[진료과목]  D001[중증질환_핫라인]\n  J000[직종]  J001[1339]  J002[응급의료기관]  J003[일반의약업]  J004[지역보건소]\n  L000[지역별링크정보]  M000[중증응급실질환]\n  N000[의료자원(필수)]  O000[의료자원(실시간)]\n  P001[의료기관구분]  P002[영업구분]  P003[진료과목]  P004[시도]\n  S000[특수클리닉및센터]  SIDO[지역코드]\n  Y000[증상]  Y001[점검]  Y002[질환별정보상태]  Y003[중증이용_미수용사유]\n  Y004[중증이용_수용사유]  Y005[중증이용_부정확사유]  Y006[중증이용_통화자_구분]\n  Y007[중증이용_의뢰경로]  Y008[중증이용_전원처리결과]  Y009[중증이용_연락번호구분]\n  Z000[정보센터]\n  AED0[구비의무기관]  AED1[다중이용시설]  AED2[공동주택]\n  AMBL[기도(1**)/호흡(2**)/순환(3**)/약품(4**)/고정(5**)/기타(6**)]\n  A~L: 시도별 시군구 코드\n    A[서울특별시/제주시]  B[부산광역시/울산광역시]  C[대구광역시/경상북도]\n    D[광주광역시/전라남도]  E[대전광역시/충청북도]  F[인천광역시]\n    G[경기도]  H[경기도]  I[강원도]  J[강원도]  K[전라북도]  L[경상남도]",
        "schema": {
          "type": "string",
          "maxLength": 20
        }
      }
    },
