# backend/deploy.sh 가 읽는 값. 복사해서 backend/.env 로 둔다(gitignore).
#
#   cp backend/.env.example backend/.env
#   backend/deploy.sh develop develop-a1b2c3d
#
# CI 에서는 같은 값이 GitHub Secrets/Variables 로 들어간다(.github/workflows/be-deploy.yml).
#
# SSH 키와 WireGuard 설정은 **경로도 내용도 받는다.** 로컬에서는 경로를 가리키는 편이
# 자연스럽고, GitHub Secrets 에는 파일을 못 넣어 내용이 문자열로 들어온다.

# 배포 서버. WireGuard 안쪽 주소다.
BE_HANSAPP_DEPLOY_SSH_HOST=ubuntu@10.0.0.101

# 배포 경로. 서버 셸이 ~ 를 푼다.
BE_HANSAPP_DEPLOY_PATH=~/app/hansapp-develop

# SSH 개인키. 경로를 권한다.
BE_HANSAPP_DEPLOY_SSH_KEY_FILE=~/.ssh/id_hansapp_deploy

# 선택. 서버 host key. 없으면 첫 접속을 그대로 받아들인다(경고가 뜬다).
#   ssh-keyscan -H 10.0.0.101
#BE_HANSAPP_DEPLOY_SSH_KNOWN_HOSTS=~/.ssh/known_hosts_hansapp

# WireGuard 는 **여기 두지 않는다.** 로컬은 VPN 이 이미 붙어 있다고 보기 때문이다.
# deploy.sh 가 이 값을 강제로 비우므로, 채워도 무시된다.
