{
  "name": "hansapp-batch",
  "version": "0.10.0",
  "private": true,
  "description": "공공데이터를 로컬 DB 에 적재하는 배치. 크론으로 단계를 순서대로 돌린다",
  "scripts": {
    "start": "node --conditions src -r @swc-node/register src/main.ts",
    "start:once": "node --conditions src -r @swc-node/register src/main.ts --once",
    "build": "tsc -p tsconfig.json && node ../../scripts/build-info.mjs",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@hansapp/admin-application": "workspace:*",
    "@hansapp/common": "workspace:*",
    "@hansapp/data": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/schedule": "^6.0.1",
    "@sentry/nestjs": "^10.68.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
