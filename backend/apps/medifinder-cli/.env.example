# MediFinder 운영 CLI.
#
# hans-api 는 IP 당 60초에 300회로 막는다. 전량이 900회 남짓이라 클라이언트가 알아서
# 간격을 벌리고 429 면 물러섰다 다시 시도한다
# (packages/medifinder-admin-application/src/hansapi/transport.ts).

MEDIFINDER_API_BASE_URL=https://api.plzhans.com
# 서버-서버 자격증명. sk_{appId}_{keyId}_{rand}
# X-Client-Id 를 쓰지 않는 이유는 그쪽이 요청 Origin 을 대조하기 때문이다 — CLI 는 Origin 이 없다.
MEDIFINDER_API_SERVICE_KEY=
MEDIFINDER_SITE_URL=https://medifinder.kr

# 아래 R2 값은 `sitemap upload` 에만 필요하다. 하나라도 비면 업로드가 꺼진다.
# `sitemap build` 는 이 값들이 없어도 돌아간다.

# 객체 키 접두사. 워커가 APP_ENV 로 같은 값을 만들어 읽는다.
MEDIFINDER_APP_ENV=production

MEDIFINDER_R2_ACCOUNT_ID=
MEDIFINDER_R2_BUCKET=medifinder-sitemap
MEDIFINDER_R2_ACCESS_KEY_ID=
MEDIFINDER_R2_SECRET_ACCESS_KEY=
