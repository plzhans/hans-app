# MediFinder 운영 CLI.
#
# **자격증명은 소유한 시스템 이름을 단다.** hans-api 것은 HANSAPP_, Cloudflare 것은 R2_,
# medifinder 자신의 것만 MEDIFINDER_ 다 — 프론트(.env.develop)의 VITE_HANSAPP_BASE_URL 과
# 같은 규칙이다.

# hans-api 주소. 키를 발급한 환경과 맞아야 한다 — 어긋나면 401 이다.
HANSAPP_BASE_URL=https://develop-api.plzhans.com
# 서버-서버 자격증명. sk_{appId}_{keyId}_{rand}
# X-Client-Id 를 쓰지 않는 이유는 그쪽이 요청 Origin 을 대조하기 때문이다 — CLI 는 Origin 이 없다.
HANSAPP_SERVER_KEY=

# 사이트맵에 적을 주소.
MEDIFINDER_SITE_URL=https://medifinder.kr
# 환경 이름. **산출물 디렉터리와 R2 객체 키 접두사 둘 다**에 쓰인다.
#   --out ./out  →  ./out/medifinder_production_sitemap/
#   R2 객체 키    →  production/sitemap.xml
MEDIFINDER_APP_ENV=production

# 아래는 `sitemap upload` 에만 필요하다. 하나라도 비면 업로드가 꺼진다.
# `sitemap build` 는 이 값들이 없어도 돌아간다.
R2_ACCOUNT_ID=
R2_BUCKET=medifinder-sitemap
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
