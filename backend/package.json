{
  "name": "hans-api",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:server": "SWC_NODE_PROJECT=apps/hansapi-server/tsconfig.json node --conditions src -r @swc-node/register --watch apps/hansapi-server/src/main.ts",
    "build": "pnpm -r build && ./scripts/build-report.sh",
    "ci:build": "./scripts/build.sh",
    "ci:bundle": "../scripts/ci/run-in-builder.sh ./backend/scripts/build.sh",
    "ci:deploy": "./scripts/deploy.sh",
    "lint": "eslint \"{apps,packages,clients}/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,packages,clients}/*/**/*.{ts,js,json}\"",
    "check": "pnpm exec eslint \"{apps,packages,clients}/*/src/**/*.ts\" && pnpm exec prettier --check \"{apps,packages,clients}/*/**/*.{ts,js,json}\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f hansapi-db",
    "db:cli": "docker compose exec hansapi-db mysql -ulocal_hansapi -p'local_hansapi' local_hansapi",
    "db:migrate": "APP_ENV=local pnpm --filter @hansapi/data prisma:migrate:deploy",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "clean": "rm -rf node_modules {apps,packages,clients}/*/dist",
    "reinstall": "rm -rf node_modules && pnpm install",
    "hansapi-cli": "SWC_NODE_PROJECT=apps/hansapi-cli/tsconfig.json node --conditions src -r @swc-node/register apps/hansapi-cli/src/main.ts",
    "krdata:codegen": "pnpm --filter \"@krdata/*\" codegen",
    "seouldata:codegen": "pnpm --filter \"@seouldata/*\" codegen",
    "kr-go:codegen": "pnpm --filter \"@kr-go/*\" codegen",
    "openapi:gen": "pnpm --filter hansapi-server openapi:gen",
    "hansapi-batch": "SWC_NODE_PROJECT=apps/hansapi-batch/tsconfig.json node --conditions src -r @swc-node/register apps/hansapi-batch/src/main.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.13.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}
