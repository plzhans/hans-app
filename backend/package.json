{
  "name": "hansapp-backend",
  "version": "0.16.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:server": "SWC_NODE_PROJECT=apps/hansapp-api/tsconfig.json node --conditions src -r @swc-node/register --watch apps/hansapp-api/src/main.ts",
    "start:local": "APP_ENV=local pnpm dev:server",
    "start:develop": "APP_ENV=develop pnpm dev:server",
    "dev:admin": "SWC_NODE_PROJECT=apps/hansapp-admin-api/tsconfig.json node --conditions src -r @swc-node/register --watch apps/hansapp-admin-api/src/main.ts",
    "start:admin:local": "APP_ENV=local pnpm dev:admin",
    "start:admin:develop": "APP_ENV=develop pnpm dev:admin",
    "build": "pnpm -r build",
    "lint": "eslint \"{apps,packages,clients}/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,packages,clients}/*/**/*.{ts,js,json}\"",
    "check": "pnpm exec eslint \"{apps,packages,clients}/*/src/**/*.ts\" && pnpm exec prettier --check \"{apps,packages,clients}/*/**/*.{ts,js,json}\"",
    "test": "pnpm -r test",
    "db:migrate": "APP_ENV=local pnpm --filter @hansapp/data prisma:migrate:deploy",
    "clean": "rm -rf node_modules {apps,packages,clients}/*/dist",
    "reinstall": "rm -rf node_modules && pnpm install",
    "hansapp-cli": "SWC_NODE_PROJECT=apps/hansapp-cli/tsconfig.json node --conditions src -r @swc-node/register apps/hansapp-cli/src/main.ts",
    "krdata:codegen": "pnpm --filter \"@krdata/*\" codegen",
    "seouldata:codegen": "pnpm --filter \"@seouldata/*\" codegen",
    "kr-go:codegen": "pnpm --filter \"@kr-go/*\" codegen",
    "openapi:gen": "pnpm --filter hansapp-api openapi:gen",
    "openapi:gen:local": "pnpm --filter hansapp-api openapi:gen:local",
    "openapi:gen:dev": "pnpm --filter hansapp-api openapi:gen:dev",
    "openapi:gen:prod": "pnpm --filter hansapp-api openapi:gen:prod",
    "hansapp-batch": "SWC_NODE_PROJECT=apps/hansapp-batch/tsconfig.json node --conditions src -r @swc-node/register apps/hansapp-batch/src/main.ts",
    "vworld:codegen": "pnpm --filter \"@vworld/*\" codegen"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.13.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}
