# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
# env 파일은 이름이 .env 로 끝난다: 항상 불러오는 .env, 환경별 <환경>.env(develop.env …),
# 개인 오버라이드 <환경>.local.env, 로컬 배포 설정 local-deploy-<환경>.env.
# 전부 시크릿이 들어갈 수 있으니 .env 로 끝나면 다 막는다.
*.env
# 커밋 대상은 예시(.example)와 sops 로 암호화한 것(.enc)뿐.
!*.example
!*.enc

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Cache
.cache/
.eslintcache
.turbo/

# Prisma 생성 클라이언트 (pnpm install / build 시 재생성)
packages/hansapi-data/generated/

# 번역 작업용 중간 산출물 (JSONL). 커밋하지 않는다 — 재생성 가능하고 수 MiB 다.
/temp/
