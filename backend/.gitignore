# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
# env 파일은 config/ 바로 밑에 평면으로 둔다: 항상 불러오는 .env, 환경별 .env.<환경>(.env.develop …),
# 개인 오버라이드 .env.<환경>.local. (로컬 배포 설정 local-deploy-<환경>.env 는 이름이 .env 로 끝난다.)
# 시크릿이 들어갈 수 있으니 .env 로 시작하거나(.env*) 끝나면(*.env) 다 막는다.
*.env
.env*
# 커밋 대상은 예시(.example)와 sops 로 암호화한 것(.enc)뿐.
!*.example
!*.enc

# JWT 서명 개인키(PEM). 평문은 절대 커밋 금지 — sops 로 암호화한 .key.enc 만 추적한다.
# 공개키(.pub)는 공개돼도 안전해 막지 않는다(JWKS 로도 어차피 노출).
*.key
!*.key.enc

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Cache
.cache/
.eslintcache
.turbo/

# Prisma 생성 클라이언트 (pnpm install / build 시 재생성)
packages/hansapp-data/generated/

# 번역 작업용 중간 산출물 (JSONL). 커밋하지 않는다 — 재생성 가능하고 수 MiB 다.
/temp/
