#!/bin/sh
# root 는 "어느 워크스페이스가 바뀌었나"만 보고, 그 워크스페이스의 .husky/<동일이름> 훅으로 위임.
# (무엇을 할지는 각 워크스페이스가 소유. frontend/.husky/pre-commit 이 생기면 자동 포함)
CHANGED=$(git diff --cached --name-only)
for ws in backend frontend; do
  echo "$CHANGED" | grep -q "^$ws/" || continue
  [ -f "$ws/.husky/pre-commit" ] || continue
  ( cd "$ws" && sh .husky/pre-commit "$@" ) || exit $?
done
